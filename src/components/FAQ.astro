---
interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
  title?: string;
  eyebrow?: string;
}
const { items, title = 'Frequently asked questions', eyebrow = 'FAQ' } = Astro.props;
---
<section class="section faq-section" aria-labelledby="faq-heading">
  <div class="container container-narrow">
    <span class="eyebrow">{eyebrow}</span>
    <h2 id="faq-heading">{title}</h2>
    <div class="faq-list">
      {items.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section { background: var(--color-bg-soft); }
  .faq-list { margin-top: var(--space-6); }
</style>
