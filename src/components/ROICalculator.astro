---
import { INDUSTRY_PRESETS, SITE } from '@lib/site';

interface Props {
  variant?: 'inline' | 'modal';
  id?: string;
  showMethodologyLink?: boolean;
}
const { variant = 'inline', id = 'roi-calc', showMethodologyLink = true } = Astro.props;
const calcId = id;
---
<div class:list={['roi-calc', `roi-calc--${variant}`]} data-roi-calc id={calcId}>
  <div class="roi-calc__header">
    <span class="eyebrow">Fortify AI ROI calculator</span>
    <h3 class="roi-calc__title">Estimate your annual AI productivity opportunity</h3>
    <p class="roi-calc__sub">Pick an industry to autofill realistic defaults. Adjust the sliders to match your firm.</p>
  </div>

  <div class="roi-calc__controls">
    <div class="roi-field">
      <label for={`${calcId}-industry`}>Industry</label>
      <select id={`${calcId}-industry`} data-roi-industry>
        {INDUSTRY_PRESETS.map((p) => (
          <option value={p.id} data-employees={p.employees} data-hourly={p.hourly}>
            {p.label}
          </option>
        ))}
      </select>
    </div>

    <div class="roi-field">
      <div class="roi-field__head">
        <label for={`${calcId}-employees`}>Employees</label>
        <output for={`${calcId}-employees`} data-roi-employees-output>150</output>
      </div>
      <input
        id={`${calcId}-employees`}
        type="range"
        min="1"
        max="50000"
        step="1"
        value="150"
        data-roi-employees
        aria-label="Number of employees, from 1 to 50,000"
      />
      <div class="roi-field__row">
        <div class="roi-field__scale roi-field__scale--grow">
          <span>1</span><span>50,000</span>
        </div>
        <div class="roi-field__numeric">
          <label for={`${calcId}-employees-num`} class="sr-only">Type exact employee count</label>
          <input
            id={`${calcId}-employees-num`}
            type="number"
            min="1"
            max="50000"
            step="1"
            value="150"
            inputmode="numeric"
            data-roi-employees-num
            aria-label="Type exact employee count"
          />
        </div>
      </div>
    </div>

    <div class="roi-field">
      <div class="roi-field__head">
        <label for={`${calcId}-hourly`}>Average hourly cost (USD)</label>
        <output for={`${calcId}-hourly`} data-roi-hourly-output>$52</output>
      </div>
      <input
        id={`${calcId}-hourly`}
        type="range"
        min="15"
        max="1000"
        step="1"
        value="52"
        data-roi-hourly
        aria-label="Average hourly fully loaded cost per employee in US dollars"
      />
      <div class="roi-field__row">
        <div class="roi-field__scale roi-field__scale--grow">
          <span>$15</span><span>$1,000</span>
        </div>
        <div class="roi-field__numeric">
          <label for={`${calcId}-hourly-num`} class="sr-only">Type exact average hourly cost</label>
          <input
            id={`${calcId}-hourly-num`}
            type="number"
            min="15"
            max="1000"
            step="1"
            value="52"
            inputmode="numeric"
            data-roi-hourly-num
            aria-label="Type exact average hourly cost in US dollars"
          />
        </div>
      </div>
    </div>

    <div class="roi-field">
      <div class="roi-field__head">
        <label for={`${calcId}-hours`}>Hours saved per week per employee</label>
        <output for={`${calcId}-hours`} data-roi-hours-output>5</output>
      </div>
      <input
        id={`${calcId}-hours`}
        type="range"
        min="1"
        max="15"
        step="1"
        value="5"
        data-roi-hours
        aria-label="Hours saved per week per employee"
      />
      <div class="roi-field__scale"><span>1</span><span>15</span></div>
    </div>
  </div>

  <div class="roi-calc__results" aria-live="polite">
    <p class="roi-calc__annual-label">Estimated annual productivity opportunity<span class="roi-calc__star">*</span></p>
    <p class="roi-calc__annual" data-roi-annual>$1,950,000</p>
    <div class="roi-calc__secondary">
      <div>
        <p class="roi-calc__sub-label">Per month</p>
        <p class="roi-calc__sub-value" data-roi-monthly>$168,870</p>
      </div>
      <div>
        <p class="roi-calc__sub-label">Per week</p>
        <p class="roi-calc__sub-value" data-roi-weekly>$39,000</p>
      </div>
    </div>
    <p class="roi-calc__context" data-roi-context>
      For a typical healthcare practice with 150 employees, that is what a five hour per week productivity uplift is worth, year over year.
    </p>
    <p class="roi-calc__footnote">* Based on 50 working weeks per employee, allowing about two weeks of paid time off when no hours are saved.</p>
  </div>

  <div class="roi-calc__ctas">
    <a href={SITE.bookingUrl} class="btn btn-accent" target="_blank" rel="noopener">
      Book a 30 minute consultation
    </a>
    {showMethodologyLink && (
      <a href="/roi-calculator" class="btn btn-outline">See full methodology</a>
    )}
  </div>

  <p class="disclaimer roi-calc__disclaimer">
    Estimated savings are based on assumed inputs and industry productivity research.
    Actual results vary by industry, deployment scope, and execution. This calculator
    is for illustrative purposes only and is not a forecast of actual results. Annual
    figures are calculated on 50 working weeks per employee, allowing roughly two weeks
    of paid time off, when no hours are saved. Wage data sourced from U.S. Bureau of
    Labor Statistics Occupational Employment Statistics, May 2024. Productivity
    assumptions sourced from recent studies on generative AI impact in knowledge work
    (4 to 8 hours per employee per week is the industry-cited range; this calculator
    defaults to 5).
  </p>
</div>

<style>
  .roi-calc {
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
  }
  .roi-calc--modal { border: none; }
  .roi-calc__header { margin-bottom: var(--space-6); }
  .roi-calc__title {
    font-size: var(--fs-xl);
    margin-top: var(--space-2);
  }
  .roi-calc__sub {
    color: var(--color-text-soft);
    margin-top: var(--space-2);
    font-size: var(--fs-sm);
  }

  .roi-calc__controls {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .roi-calc__controls { grid-template-columns: 1fr 1fr; }
  }

  .roi-field { display: flex; flex-direction: column; gap: var(--space-2); }
  .roi-field__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  .roi-field label {
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .roi-field output {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-md);
    color: var(--color-accent-500);
  }
  .roi-field select {
    padding: 0.75em 1em;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    min-height: 48px;
    font-size: var(--fs-base);
  }
  .roi-field__scale {
    display: flex;
    justify-content: space-between;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  .roi-field__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .roi-field__scale--grow { flex: 1 1 auto; }
  .roi-field__numeric input {
    width: 96px;
    padding: 0.45em 0.6em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
    text-align: right;
    -moz-appearance: textfield;
  }
  .roi-field__numeric input::-webkit-outer-spin-button,
  .roi-field__numeric input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .roi-field__numeric input:focus {
    border-color: var(--color-accent-500);
    outline: none;
  }

  /* Range track */
  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    background: var(--color-bg-muted);
    border-radius: var(--radius-pill);
    outline: none;
    margin: var(--space-2) 0;
    cursor: pointer;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    background: var(--color-accent-500);
    border: 3px solid #fff;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0,180,255,0.4);
    cursor: pointer;
  }
  input[type="range"]::-moz-range-thumb {
    width: 24px;
    height: 24px;
    background: var(--color-accent-500);
    border: 3px solid #fff;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0,180,255,0.4);
    cursor: pointer;
  }
  input[type="range"]:focus-visible {
    box-shadow: 0 0 0 3px rgba(0,180,255,0.35);
  }

  .roi-calc__results {
    margin-top: var(--space-7);
    padding: var(--space-6);
    background: linear-gradient(135deg, var(--color-ink-900) 0%, var(--color-ink-700) 100%);
    border-radius: var(--radius-lg);
    color: #fff;
    text-align: center;
  }
  .roi-calc__annual-label {
    text-transform: uppercase;
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    color: var(--color-glow);
    font-weight: 600;
  }
  .roi-calc__annual {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.75rem, 1.75rem + 6vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fff;
    margin: var(--space-3) 0;
    background: linear-gradient(180deg, #fff 0%, #B7C6D8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .roi-calc__secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    max-width: 360px;
    margin: var(--space-5) auto 0;
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255,255,255,0.12);
  }
  .roi-calc__sub-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.6);
    margin-bottom: var(--space-1);
  }
  .roi-calc__sub-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-lg);
    color: #fff;
  }
  .roi-calc__context {
    margin-top: var(--space-5);
    color: rgba(255,255,255,0.85);
    font-size: var(--fs-sm);
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }
  .roi-calc__footnote {
    margin-top: var(--space-3);
    font-size: var(--fs-xs);
    color: rgba(255,255,255,0.55);
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }
  .roi-calc__star { color: var(--color-glow); margin-left: 0.1em; }

  .roi-calc__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  @media (min-width: 640px) {
    .roi-calc__ctas { flex-direction: row; justify-content: center; }
  }
  .roi-calc__disclaimer {
    margin: var(--space-5) auto 0;
    max-width: 80ch;
    text-align: center;
  }
</style>

<script>
  type Ctx = {
    el: HTMLElement;
    industry: HTMLSelectElement;
    employees: HTMLInputElement;
    employeesNum: HTMLInputElement;
    hourly: HTMLInputElement;
    hourlyNum: HTMLInputElement;
    hours: HTMLInputElement;
    out: {
      employees: HTMLElement;
      hourly: HTMLElement;
      hours: HTMLElement;
      annual: HTMLElement;
      monthly: HTMLElement;
      weekly: HTMLElement;
      context: HTMLElement;
    };
  };

  const fmtUSD = (n: number) =>
    n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const fmtNum = (n: number) => n.toLocaleString('en-US');

  // Variable step snap for the employee count.
  // 1-150: step 1. 150-1000: step 50. 1000-50000: step 250.
  function snapEmployees(raw: number): number {
    const clamped = Math.max(1, Math.min(50000, Math.round(raw)));
    if (clamped <= 150) return clamped;
    if (clamped <= 1000) return Math.round(clamped / 50) * 50;
    return Math.round(clamped / 250) * 250;
  }

  function calc(ctx: Ctx) {
    const employees = snapEmployees(Number(ctx.employees.value));
    const hourly = Number(ctx.hourly.value);
    const hours = Number(ctx.hours.value);

    // Keep slider + number input synced to the snapped value.
    if (Number(ctx.employees.value) !== employees) {
      ctx.employees.value = String(employees);
    }
    if (Number(ctx.employeesNum.value) !== employees && document.activeElement !== ctx.employeesNum) {
      ctx.employeesNum.value = String(employees);
    }
    // Keep the hourly number box in sync with the slider.
    if (Number(ctx.hourlyNum.value) !== hourly && document.activeElement !== ctx.hourlyNum) {
      ctx.hourlyNum.value = String(hourly);
    }

    const weekly = employees * hourly * hours;
    const monthly = weekly * 4.33;
    const annual = employees * hourly * hours * 50;

    ctx.out.employees.textContent = fmtNum(employees);
    ctx.out.hourly.textContent = fmtUSD(hourly);
    ctx.out.hours.textContent = String(hours);
    ctx.out.annual.textContent = fmtUSD(annual);
    ctx.out.monthly.textContent = fmtUSD(monthly);
    ctx.out.weekly.textContent = fmtUSD(weekly);

    const industryLabel = ctx.industry.options[ctx.industry.selectedIndex].text.toLowerCase();
    ctx.out.context.textContent =
      `For a ${industryLabel} firm with ${fmtNum(employees)} employees, ` +
      `that is what a ${hours} hour per week productivity uplift is worth, year over year.`;
  }

  document.querySelectorAll<HTMLElement>('[data-roi-calc]').forEach((el) => {
    const ctx: Ctx = {
      el,
      industry: el.querySelector('[data-roi-industry]') as HTMLSelectElement,
      employees: el.querySelector('[data-roi-employees]') as HTMLInputElement,
      employeesNum: el.querySelector('[data-roi-employees-num]') as HTMLInputElement,
      hourly: el.querySelector('[data-roi-hourly]') as HTMLInputElement,
      hourlyNum: el.querySelector('[data-roi-hourly-num]') as HTMLInputElement,
      hours: el.querySelector('[data-roi-hours]') as HTMLInputElement,
      out: {
        employees: el.querySelector('[data-roi-employees-output]') as HTMLElement,
        hourly: el.querySelector('[data-roi-hourly-output]') as HTMLElement,
        hours: el.querySelector('[data-roi-hours-output]') as HTMLElement,
        annual: el.querySelector('[data-roi-annual]') as HTMLElement,
        monthly: el.querySelector('[data-roi-monthly]') as HTMLElement,
        weekly: el.querySelector('[data-roi-weekly]') as HTMLElement,
        context: el.querySelector('[data-roi-context]') as HTMLElement,
      },
    };

    ctx.industry.addEventListener('change', () => {
      const opt = ctx.industry.options[ctx.industry.selectedIndex];
      const emp = opt.getAttribute('data-employees');
      const hr = opt.getAttribute('data-hourly');
      if (emp) {
        ctx.employees.value = emp;
        ctx.employeesNum.value = emp;
      }
      if (hr) {
        ctx.hourly.value = hr;
        ctx.hourlyNum.value = hr;
      }
      calc(ctx);
    });

    // Slider drives calc and syncs the number input
    ctx.employees.addEventListener('input', () => calc(ctx));

    // Number input drives calc and syncs the slider. Snap on blur or Enter,
    // allow free typing in between (but cap at max during input).
    ctx.employeesNum.addEventListener('input', () => {
      const raw = Number(ctx.employeesNum.value);
      if (Number.isFinite(raw)) {
        const capped = Math.max(1, Math.min(50000, raw));
        ctx.employees.value = String(capped);
        calc(ctx);
      }
    });
    const snapNum = () => {
      const snapped = snapEmployees(Number(ctx.employeesNum.value));
      ctx.employeesNum.value = String(snapped);
      ctx.employees.value = String(snapped);
      calc(ctx);
    };
    ctx.employeesNum.addEventListener('blur', snapNum);
    ctx.employeesNum.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        snapNum();
        (ctx.employeesNum as HTMLInputElement).blur();
      }
    });

    [ctx.hourly, ctx.hours].forEach((input) =>
      input.addEventListener('input', () => calc(ctx))
    );

    // Hourly number box drives the slider. Free typing in between, clamp on
    // blur or Enter. Range is $15 to $1,000.
    ctx.hourlyNum.addEventListener('input', () => {
      const raw = Number(ctx.hourlyNum.value);
      if (Number.isFinite(raw) && ctx.hourlyNum.value !== '') {
        const capped = Math.max(15, Math.min(1000, raw));
        ctx.hourly.value = String(capped);
        calc(ctx);
      }
    });
    const clampHourly = () => {
      const v = Math.max(15, Math.min(1000, Math.round(Number(ctx.hourlyNum.value) || 15)));
      ctx.hourlyNum.value = String(v);
      ctx.hourly.value = String(v);
      calc(ctx);
    };
    ctx.hourlyNum.addEventListener('blur', clampHourly);
    ctx.hourlyNum.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        clampHourly();
        (ctx.hourlyNum as HTMLInputElement).blur();
      }
    });

    calc(ctx);
  });
</script>
