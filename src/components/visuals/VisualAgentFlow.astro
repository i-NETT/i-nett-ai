---
/**
 * VisualAgentFlow — an agent processing real work.
 * Task cards slide into the agent, the agent "thinks" (pulsing core),
 * and completed items come out the other side. Loops. CSS-only,
 * decorative (aria-hidden), reduced-motion shows a static frame.
 */
---
<div class="vaf" aria-hidden="true">
  <div class="vaf__lane">
    <!-- incoming tasks -->
    <div class="vaf__in">
      <span class="vaf__task vaf__task--1">Invoice #2214</span>
      <span class="vaf__task vaf__task--2">New client intake</span>
      <span class="vaf__task vaf__task--3">Meeting notes</span>
    </div>

    <!-- the agent -->
    <div class="vaf__agent">
      <span class="vaf__agent-ring"></span>
      <svg viewBox="0 0 40 40" width="34" height="34">
        <rect x="7" y="13" width="26" height="19" rx="5" fill="none" stroke="currentColor" stroke-width="2.2"/>
        <path d="M20 6 V13 M13 8.5 H27" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        <circle class="vaf__eye vaf__eye--l" cx="15.5" cy="22" r="2.2" fill="currentColor"/>
        <circle class="vaf__eye vaf__eye--r" cx="24.5" cy="22" r="2.2" fill="currentColor"/>
      </svg>
      <em>Your agent</em>
    </div>

    <!-- completed output -->
    <div class="vaf__out">
      <span class="vaf__done vaf__done--1"><i>&#10003;</i> Processed &amp; filed</span>
      <span class="vaf__done vaf__done--2"><i>&#10003;</i> Summarized &amp; routed</span>
      <span class="vaf__done vaf__done--3"><i>&#10003;</i> Action items sent</span>
    </div>
  </div>

  <div class="vaf__foot">
    <span class="vaf__dot"></span> Working 24/7 &middot; token-optimized
  </div>
</div>

<style>
  .vaf {
    --loop: 7.5s;
    background: linear-gradient(165deg, #0e1c2c 0%, #0a1420 100%);
    border: 1px solid rgba(0,180,255,0.22);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    box-shadow: 0 24px 60px -20px rgba(0,0,0,0.55), 0 0 40px -18px rgba(0,180,255,0.45);
    max-width: 460px;
    width: 100%;
  }
  .vaf__lane {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
    min-height: 150px;
  }
  .vaf__in, .vaf__out { display: grid; gap: var(--space-2); }

  .vaf__task {
    display: block;
    padding: 0.45em 0.7em;
    border-radius: 8px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(140,170,205,0.3);
    color: rgba(220,232,244,0.85);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vaf__task--1 { animation: vaf-feed var(--loop) ease-in-out infinite; }
  .vaf__task--2 { animation: vaf-feed var(--loop) ease-in-out infinite 0.4s; }
  .vaf__task--3 { animation: vaf-feed var(--loop) ease-in-out infinite 0.8s; }
  @keyframes vaf-feed {
    0% { opacity: 0; transform: translateX(-14px); }
    8% { opacity: 1; transform: translateX(0); }
    34% { opacity: 1; transform: translateX(0); }
    46% { opacity: 0; transform: translateX(16px); }
    100% { opacity: 0; transform: translateX(16px); }
  }

  .vaf__agent {
    position: relative;
    display: grid;
    place-items: center;
    gap: 4px;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: rgba(0,180,255,0.10);
    border: 1px solid rgba(0,224,255,0.4);
    color: #6FD9FF;
  }
  .vaf__agent em {
    font-style: normal; font-size: 0.65rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: rgba(207,242,255,0.8);
  }
  .vaf__agent-ring {
    position: absolute; inset: -1px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(0,224,255,0.6);
    animation: vaf-think var(--loop) ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes vaf-think {
    0%, 30% { opacity: 0; transform: scale(1); }
    40% { opacity: 1; }
    50% { opacity: 0.4; transform: scale(1.12); }
    58%, 100% { opacity: 0; transform: scale(1.18); }
  }
  .vaf__eye { animation: vaf-blink 3.4s ease-in-out infinite; transform-origin: center; }
  @keyframes vaf-blink {
    0%, 42%, 48%, 100% { transform: scaleY(1); }
    45% { transform: scaleY(0.15); }
  }

  .vaf__done {
    display: flex; align-items: center; gap: 6px;
    padding: 0.45em 0.7em;
    border-radius: 8px;
    background: rgba(0,180,255,0.12);
    border: 1px solid rgba(0,224,255,0.35);
    color: #D8F4FF;
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vaf__done i {
    font-style: normal; font-weight: 700; color: #00E0FF; flex-shrink: 0;
  }
  .vaf__done--1 { animation: vaf-out var(--loop) ease-in-out infinite; }
  .vaf__done--2 { animation: vaf-out var(--loop) ease-in-out infinite 0.4s; }
  .vaf__done--3 { animation: vaf-out var(--loop) ease-in-out infinite 0.8s; }
  @keyframes vaf-out {
    0%, 52% { opacity: 0; transform: translateX(-14px); }
    62% { opacity: 1; transform: translateX(0); }
    92% { opacity: 1; }
    100% { opacity: 0; }
  }

  .vaf__foot {
    display: flex; align-items: center; gap: 8px;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: rgba(183,198,216,0.6);
    letter-spacing: 0.03em;
  }
  .vaf__dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #00E0FF;
    box-shadow: 0 0 0 0 rgba(0,224,255,0.6);
    animation: vaf-live 2.2s ease-out infinite;
  }
  @keyframes vaf-live {
    0% { box-shadow: 0 0 0 0 rgba(0,224,255,0.55); }
    70% { box-shadow: 0 0 0 8px rgba(0,224,255,0); }
    100% { box-shadow: 0 0 0 0 rgba(0,224,255,0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .vaf * { animation: none !important; }
    .vaf__task, .vaf__done { opacity: 1; transform: none; }
    .vaf__agent-ring { opacity: 0; }
  }
</style>
