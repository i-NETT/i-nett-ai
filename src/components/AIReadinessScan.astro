---
/**
 * AIReadinessScan.astro — Fortify AI Readiness & Risk Scan
 *
 * A self-contained, multi-screen assessment: intro -> adaptive questions ->
 * analysis theater -> scored report + findings -> lead gate -> results -> book.
 *
 * The report is computed ENTIRELY client-side (computeReport) so it renders
 * complete even if the backend is unreachable. The Worker call only enhances
 * the Analyst Note with a personalized paragraph, and routes the lead into
 * HubSpot. Ported from the AITS AI Risk Scan, reskinned to the i-NETT brand
 * and re-positioned around Fortify AI's three pillars + security/compliance.
 *
 * Backend: see /Scan tool/inett-scan (Cloudflare Worker). Update PROXY_URL
 * below to the deployed Worker URL.
 */
import { SITE } from '../lib/site';
---

<section class="section" id="scan">
  <div class="container">
    <div class="scan" id="scanRoot">
      <div class="scan__head">
        <div class="scan__brandRow">
          <img src="/assets/brand/inett-logo.png" alt="i-NETT" class="scan__brandLogo scan__brandLogo--inett" loading="eager" decoding="sync">
          <span class="scan__brandDivider" aria-hidden="true"></span>
          <img src="/assets/brand/fortify-ai-logo-mark.png" alt="Fortify AI" class="scan__brandLogo scan__brandLogo--fortify" loading="eager" decoding="sync">
        </div>
        <div class="scan__eyebrow">FORTIFY AI &middot; READINESS &amp; RISK SCAN</div>
        <div class="scan__title">AI Readiness &amp; Risk Scan</div>
        <div class="scan__status" id="scanStatusLine" data-phase="intro">System ready</div>
      </div>

      <div class="scan__panel" id="scanPanel">
        <!-- INTRO -->
        <div id="introScreen" class="scan__body">
          <div class="scan__tags">
            <span class="scan-tag scan-tag--accent">SHADOW AI</span>
            <span class="scan-tag scan-tag--accent">COMPLIANCE</span>
            <span class="scan-tag scan-tag--accent">ENABLEMENT</span>
            <span class="scan-tag scan-tag--accent">EXPOSURE SCORE</span>
          </div>
          <h2 class="scan__introTitle">Is your organization getting the upside of AI &mdash; without the exposure?</h2>
          <p class="scan__introSub">
            A short, no-jargon scan any leader can finish in about 90 seconds. It points to where AI is
            already in use across your team, where it may be exposing you, and where a governed rollout
            could help most. It&rsquo;s a starting point for a conversation with our team &mdash; general
            information, not a formal audit or advice. No IT knowledge needed.
          </p>
          <div class="scan__checklist">
            <div class="scan__checklistLabel">WHAT YOU GET INSTANTLY</div>
            <div class="scan__check">AI exposure score (0&ndash;100)</div>
            <div class="scan__check">Shadow AI &amp; compliance flags for your data</div>
            <div class="scan__check">Hours a week your team could hand to custom agents</div>
            <div class="scan__check">Your top findings &mdash; with what to do about each</div>
          </div>
          <div class="scan__trust">
            <span class="scan__trustItem"><span class="scan__dot"></span>No software to install</span>
            <span class="scan__trustItem"><span class="scan__dot"></span>Private &mdash; answers aren&rsquo;t stored on the page</span>
            <span class="scan__trustItem"><span class="scan__dot"></span>90 seconds</span>
          </div>
          <button class="btn btn-accent btn-lg btn-block" id="startBtn">
            Start my free scan <span aria-hidden="true">&rarr;</span>
          </button>
        </div>

        <!-- QUESTIONS -->
        <div id="questionScreen" style="display:none">
          <div class="scan__progress"><div class="scan__progressFill" id="progressFill" style="width:0%"></div></div>
          <div class="scan__body">
            <div class="scan__qHeader">
              <div class="scan__qCount" id="qCount">Q 1</div>
              <div class="scan__qDots" id="qDots"></div>
            </div>
            <div class="scan__qLabel" id="qLabel"></div>
            <div class="scan__qNote" id="qNote" style="display:none"></div>
            <div class="scan__options" id="optionsList"></div>
            <button class="btn btn-outline btn-block scan__skip" id="multiNextBtn" style="display:none">Skip <span aria-hidden="true">&rarr;</span></button>
          </div>
        </div>

        <!-- ANALYSIS THEATER -->
        <div id="scanScreen" style="display:none" class="scan__body">
          <div class="scan__consoleHead" id="scanHeader">Analysis in progress</div>
          <div class="scan__scanBar"><div class="scan__scanBarFill" id="scanFill" style="width:0%"></div></div>
          <div class="scan__console" id="terminal"><span id="cursor" class="scan__cursor">_</span></div>
          <div class="scan__pct" id="scanPct">0% complete</div>
        </div>

        <!-- RESULTS -->
        <div id="resultsScreen" style="display:none">
          <div class="scan__resultsTop">
            <div>
              <div class="scan__resultsEyebrow">SCAN COMPLETE</div>
              <div class="scan__resultsTitle">AI Readiness &amp; Risk Report</div>
            </div>
            <span class="scan-tag scan-tag--warn" id="riskTag">&mdash;</span>
          </div>
          <div class="scan__body">
            <div class="scan__scoreRow">
              <div class="scan__scoreCol">
                <svg width="165" height="100" viewBox="0 0 165 100" role="img" aria-label="Exposure score gauge">
                  <path d="M 15 88 A 70 70 0 0 1 150 88" fill="none" stroke="var(--color-border)" stroke-width="10" stroke-linecap="round"/>
                  <path id="meterArc" d="M 15 88 A 70 70 0 0 1 150 88" fill="none" stroke="var(--color-accent-500)" stroke-width="10" stroke-linecap="round" stroke-dasharray="220" stroke-dashoffset="220"/>
                  <circle id="meterDot" cx="82" cy="18" r="7" fill="var(--color-accent-500)"/>
                  <text id="meterScore" x="82" y="84" text-anchor="middle" font-family="var(--font-mono)" font-weight="bold" font-size="26" fill="var(--color-ink-800)">0</text>
                  <text id="meterLabel" x="82" y="98" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)" letter-spacing="3">--</text>
                </svg>
              </div>
              <div class="scan__statsCol">
                <div class="scan__stat scan__stat--warn">
                  <div class="scan__statLabel">SHADOW AI EXPOSURE</div>
                  <div class="scan__statVal" id="shadowEst">&mdash;</div>
                  <div class="scan__statSub" id="shadowSub"></div>
                </div>
                <div class="scan__stat scan__stat--danger">
                  <div class="scan__statLabel">COMPLIANCE FLAGS</div>
                  <div class="scan__statVal" id="compFlags">&mdash;</div>
                  <div class="scan__statSub" id="compSub"></div>
                </div>
                <div class="scan__stat scan__stat--teal">
                  <div class="scan__statLabel">RECOVERABLE HOURS / WEEK</div>
                  <div class="scan__statVal" id="hoursVal">&mdash;</div>
                  <div class="scan__statSub" id="hoursSub"></div>
                </div>
              </div>
            </div>

            <!-- Recoverable-capacity hero + itemized breakdown (populated in showResults) -->
            <div class="scan__recover" id="recoverBox" style="display:none">
              <div class="scan__recoverTop">
                <span class="scan__recoverLabel">RECOVERABLE CAPACITY</span>
                <span class="scan__recoverHero" id="recoverHero">&mdash;</span>
                <span class="scan__recoverSub" id="recoverSub"></span>
              </div>
              <div class="scan__recoverList" id="recoverList"></div>
              <div class="scan__recoverNote" id="recoverNote"></div>
            </div>

            <div class="scan__findingsLabel" id="shownLabel">YOUR TOP FINDINGS &mdash; AND WHAT TO DO ABOUT EACH</div>
            <div id="findingsList"></div>

            <!-- LEAD GATE -->
            <div id="gateSection">
              <div class="scan__findingsLabel" id="lockedLabel"></div>
              <div id="lockedCards"></div>
              <div class="scan__gate">
                <div class="scan__gateTitle">See your top priorities</div>
                <div class="scan__gateSub">
                  Enter your details to see your three highest-priority findings and what to do about
                  each, plus a short analyst note &mdash; right here on screen, with a private link to
                  your full report emailed to you. A member of the i-NETT team also gets a copy so we
                  can prepare before we talk.
                </div>
                <div class="scan__gateFields">
                  <input class="scan__input" id="leadName" type="text" autocomplete="name" placeholder="Your name">
                  <input class="scan__input" id="leadCompany" type="text" autocomplete="organization" placeholder="Company name">
                  <input class="scan__input scan__input--wide" id="leadWebsite" type="text" autocomplete="url" placeholder="Company website (or type 'none')">
                  <input class="scan__input" id="leadEmail" type="email" autocomplete="email" placeholder="Work email">
                  <input class="scan__input" id="leadCell" type="tel" autocomplete="tel" placeholder="Cell phone">
                </div>
                <div class="scan__gateContact">
                  <span class="scan__gateContactLabel">Best way(s) to reach you</span>
                  <div class="scan__chips" id="leadChips">
                    <button type="button" class="scan__chip" data-c="Text">Text</button>
                    <button type="button" class="scan__chip" data-c="Call">Call</button>
                    <button type="button" class="scan__chip" data-c="Email">Email</button>
                  </div>
                </div>
                <div class="scan__gateError" id="gateError" style="display:none"></div>
                <button class="btn btn-accent btn-block" id="unlockBtn">Show my top priorities <span aria-hidden="true">&rarr;</span></button>
                <div class="scan__gateFine">No spam. One follow-up from a real person &mdash; usually with something useful.</div>
              </div>
            </div>

            <!-- MEETING GATE: remaining findings are reviewed in a working session -->
            <div id="meetingGate" style="display:none">
              <div class="scan__findingsLabel" id="meetingLabel"></div>
              <div id="meetingCards"></div>
              <div class="scan__meeting">
                <div class="scan__meetingTitle">Your full report &mdash; first 15 minutes of the call.</div>
                <div class="scan__meetingSub">
                  Book a free 30-minute session. We open with your complete report, redacted findings included
                  &mdash; we verify you&rsquo;re with the organization first, so its details never reach someone
                  who simply filled out a form.
                </div>
                <button class="btn btn-accent btn-lg btn-block" id="meetingBookBtn">Book your 30-minute working session <span aria-hidden="true">&rarr;</span></button>
              </div>
            </div>

            <div class="scan__analyst" id="analystBox" style="display:none">
              <div class="scan__analystLabel">ANALYST NOTE</div>
              <div class="scan__analystText" id="analystText"></div>
            </div>

            <div class="scan__cta" id="ctaSection" style="opacity:0;transform:translateY(12px)">
              <div class="scan__ctaNote">
                <div class="scan__ctaTop">TURN THIS INTO A PLAN</div>
                <div class="scan__ctaSub">
                  In a free 30-minute review we walk your findings, show you what a governed Fortify AI
                  rollout would put in place, and map the first deployment &mdash; a prompt-coaching win, a
                  shared workflow, or a custom agent &mdash; that can be live within 30 days.
                </div>
              </div>
              <button class="btn btn-accent btn-lg btn-block" id="bookBtn">Walk through my results &mdash; book 30 min <span aria-hidden="true">&rarr;</span></button>
              <div class="scan__ctaFine">Free &middot; No obligation &middot; i-nett.ai</div>
            </div>
          </div>
        </div>
      </div>

      <p class="disclaimer scan__disclaimer">
        This scan is for general information only and is meant to be reviewed together with the i-NETT
        team. It is not a formal audit or assessment of your organization, and it is not legal,
        compliance, security, or insurance advice. Scores and estimates are illustrative and
        industry-informed, not a study of your specific situation, and any regulations named may or may
        not apply to you. By submitting your details you consent to i-NETT contacting you about your
        results. See our <a href="/privacy">privacy policy</a>.
      </p>
    </div>
  </div>
</section>

<!-- BOOKING MODAL (HubSpot Meetings) -->
<div class="scan-cal" id="calOverlay">
  <div class="scan-cal__box">
    <div class="scan-cal__header">
      <div class="scan-cal__title">Book your free 30-min review</div>
      <button class="scan-cal__close" id="calClose" aria-label="Close">&times;</button>
    </div>
    <iframe class="scan-cal__frame" id="calFrame" title="Book a review with i-NETT" src="about:blank" frameborder="0" scrolling="yes"></iframe>
    <div class="scan-cal__fallback">
      Trouble loading? <a id="calFallback" href={SITE.bookingUrl} target="_blank" rel="noopener">Open the booking page in a new tab &rarr;</a>
    </div>
  </div>
</div>

<style is:global>
  /* Styles are global (not scoped) on purpose: the questions, options, and
     findings are injected via innerHTML at runtime, and Astro's scoped-style
     data attribute is only added to elements present at build time. Every
     selector here is namespaced under .scan / .scan-tag / .scan-cal. */
  /* ===== Layout shell ===== */
  .scan { max-width: 940px; margin: 0 auto; }
  .scan__head { text-align: center; margin-bottom: var(--space-5); }
  .scan__brandRow { display: flex; align-items: center; justify-content: center; gap: var(--space-3); margin-bottom: var(--space-4); }
  .scan__brandLogo { height: 34px; width: auto; object-fit: contain; display: block; }
  .scan__brandLogo--fortify { height: 38px; }
  .scan__brandDivider { width: 1px; height: 28px; background: var(--color-border-strong); flex-shrink: 0; }
  .scan__eyebrow {
    font-family: var(--font-mono);
    font-size: 10px; letter-spacing: 3px;
    color: var(--color-accent-500); margin-bottom: var(--space-2);
  }
  .scan__title { font-size: var(--fs-xl); font-weight: 800; color: var(--color-ink-800); letter-spacing: -0.02em; }
  .scan__status {
    font-family: var(--font-mono); font-size: 11px;
    color: var(--color-text-muted); margin-top: 5px; min-height: 18px;
  }
  .scan__status::before { content: "\25AE "; color: var(--color-accent-500); }

  .scan__panel {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--space-4);
  }
  .scan__body { padding: var(--space-6) var(--space-5); }
  @media (min-width: 720px) { .scan__body { padding: var(--space-8) var(--space-8); } }
  .scan__qLabel, .scan__introTitle { max-width: 34ch; }
  .scan__introSub { max-width: 58ch; }

  /* ===== Intro ===== */
  /* The panel is wide (940px) but this content caps out much narrower —
     center the whole block instead of letting it hug the left edge. */
  #introScreen { max-width: 620px; margin: 0 auto; text-align: center; }
  .scan__tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-bottom: var(--space-5); }
  .scan-tag {
    font-family: var(--font-mono); font-size: 10px;
    border: 1px solid; padding: 3px 8px; border-radius: 3px;
    letter-spacing: 1px; white-space: nowrap;
  }
  .scan-tag--accent { color: var(--color-ink-700); border-color: rgba(0,180,255,0.45); background: rgba(0,180,255,0.07); }
  .scan-tag--warn { color: var(--color-warning); border-color: var(--color-warning); }
  .scan-tag--danger { color: var(--color-danger); border-color: var(--color-danger); }
  .scan-tag--ok { color: var(--color-success); border-color: var(--color-success); }
  .scan-tag--info { color: var(--color-ink-700); border-color: rgba(0,180,255,0.45); }

  .scan__introTitle { font-size: var(--fs-lg); font-weight: 800; line-height: 1.3; margin: 0 auto var(--space-3); color: var(--color-ink-800); }
  .scan__introSub { color: var(--color-text-soft); line-height: var(--lh-loose); font-size: var(--fs-sm); margin: 0 auto var(--space-5); }
  .scan__checklist {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-4); margin-bottom: var(--space-5);
    text-align: left;
  }
  .scan__checklistLabel { font-family: var(--font-mono); font-size: 9px; color: var(--color-accent-500); letter-spacing: 2px; margin-bottom: var(--space-2); }
  .scan__check { font-size: var(--fs-sm); color: var(--color-text-soft); line-height: 2; }
  .scan__check::before { content: "\2713  "; color: var(--color-success); font-weight: bold; }
  .scan__trust { display: flex; gap: 14px; justify-content: center; margin-bottom: var(--space-5); flex-wrap: wrap; }
  .scan__trustItem { font-size: 12px; color: var(--color-text-muted); display: flex; align-items: center; gap: 5px; }
  .scan__dot { width: 5px; height: 5px; border-radius: 50%; background: var(--color-accent-500); flex-shrink: 0; }

  /* ===== Questions ===== */
  .scan__progress { height: 4px; background: var(--color-bg-muted); }
  .scan__progressFill { height: 100%; background: var(--color-accent-500); transition: width 0.4s ease; }
  .scan__qHeader { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4); }
  .scan__qCount { font-family: var(--font-mono); font-size: 10px; color: var(--color-text-muted); }
  .scan__qDots { display: flex; gap: 5px; flex-wrap: wrap; justify-content: flex-end; max-width: 60%; }
  .scan__qDot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-border-strong); }
  .scan__qDot.active { background: var(--color-accent-500); }
  .scan__qDot.done { background: var(--color-accent-500); opacity: 0.4; }
  .scan__qLabel { font-size: var(--fs-md); font-weight: 700; line-height: 1.4; margin-bottom: var(--space-4); color: var(--color-ink-800); }
  .scan__qNote { font-family: var(--font-mono); font-size: 11px; color: var(--color-text-muted); margin-bottom: var(--space-3); margin-top: calc(-1 * var(--space-2)); }
  .scan__options { display: grid; grid-template-columns: 1fr; gap: 10px; }
  @media (min-width: 640px) { .scan__options { grid-template-columns: 1fr 1fr; } }
  .scan__opt {
    width: 100%; padding: 15px 16px; display: flex; align-items: center; gap: 12px;
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); color: var(--color-text); text-align: left;
    cursor: pointer; font-size: var(--fs-sm); font-weight: 500; line-height: 1.35;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .scan__opt:hover { border-color: var(--color-accent-500); background: var(--color-bg-soft); transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .scan__opt.selected { border-color: var(--color-accent-500); background: rgba(0,180,255,0.08); color: var(--color-ink-800); font-weight: 600; }
  /* Marker rendered as a radio ring; the ○/▪ glyph text is hidden via font-size:0. */
  .scan__optMark { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--color-border-strong); flex-shrink: 0; font-size: 0; position: relative; transition: border-color var(--dur-fast) var(--ease-out); }
  .scan__opt:hover .scan__optMark { border-color: var(--color-accent-400); }
  .scan__opt.selected .scan__optMark { border-color: var(--color-accent-500); }
  .scan__opt.selected .scan__optMark::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--color-accent-500); }
  .scan__skip { margin-top: var(--space-4); max-width: 300px; margin-left: auto; margin-right: auto; }

  /* Task inventory grid — dense, multi-column, so the breadth of automatable
     work is the visual message. Auto-fills to as many columns as fit. */
  .scan__taskGrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px; }
  .scan__task {
    display: flex; align-items: center; gap: 10px; padding: 11px 13px; text-align: left;
    background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md);
    color: var(--color-text); cursor: pointer; font-size: var(--fs-sm); font-weight: 500; line-height: 1.3;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .scan__task:hover { border-color: var(--color-accent-500); background: var(--color-bg-soft); transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .scan__task.selected { border-color: var(--color-accent-500); background: rgba(0,180,255,0.08); color: var(--color-ink-800); font-weight: 600; }
  .scan__task .scan__optMark { width: 18px; height: 18px; }
  .scan__task:hover .scan__optMark { border-color: var(--color-accent-400); }
  .scan__task.selected .scan__optMark { border-color: var(--color-accent-500); }
  .scan__task.selected .scan__optMark::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--color-accent-500); }
  .scan__taskLabel { flex: 1; }

  /* Per-area headcount steppers */
  .scan__hcRow { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 12px 14px;
    background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); margin-bottom: 8px; }
  .scan__hcLabel { font-size: var(--fs-sm); font-weight: 600; color: var(--color-ink-800); }
  .scan__hcCtl { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .scan__hcBtn { width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--color-border-strong);
    background: var(--color-bg-soft); color: var(--color-ink-800); font-size: 18px; line-height: 1; cursor: pointer; font-weight: 600; }
  .scan__hcBtn:hover { border-color: var(--color-accent-500); color: var(--color-accent-500); }
  .scan__hcNum { width: 56px; height: 32px; text-align: center; border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    font-size: var(--fs-sm); font-weight: 600; color: var(--color-ink-800); background: var(--color-bg); -moz-appearance: textfield; }
  .scan__hcNum::-webkit-outer-spin-button, .scan__hcNum::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .scan__hcEmpty { padding: 20px; text-align: center; color: var(--color-text-muted); font-size: var(--fs-sm); }

  /* Recoverable-capacity hero + itemized breakdown on the results screen. */
  .scan__recover { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 18px 20px; margin: 4px 0 22px;
    background: linear-gradient(160deg, rgba(0,180,255,0.06), rgba(0,180,255,0.01)); }
  .scan__recoverTop { display: flex; flex-direction: column; gap: 2px; margin-bottom: 14px; }
  .scan__recoverLabel { font: 600 11px/1 var(--font-mono, monospace); letter-spacing: 0.14em; color: var(--color-accent-600, #0E7FB0); }
  .scan__recoverHero { font-size: clamp(28px, 5vw, 40px); font-weight: 800; line-height: 1.05; color: var(--color-ink-900, #0B2440); letter-spacing: -0.02em; margin-top: 4px; }
  .scan__recoverSub { font-size: var(--fs-sm); color: var(--color-text-muted); margin-top: 4px; }
  .scan__recoverList { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 6px 18px; }
  .scan__recoverItem { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 5px 0; border-bottom: 1px dashed var(--color-border); font-size: var(--fs-sm); }
  .scan__recoverItem span:first-child { color: var(--color-ink-800, #0C1622); }
