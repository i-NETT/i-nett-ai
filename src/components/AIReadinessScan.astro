</style>

<script>
  import { renderReport, encodeReport, type ReportData, type ReportFinding, type Peer } from '../lib/report';
  // The capture/assembly pipeline lives in lib/reportPdf.ts so that the exact
  // code path that emails prospects can also be exercised from /report-pdf-test
  // without pushing a real lead through HubSpot.
  import { buildInternalReportPages, htmlPagesToPdf, imageToDataUri, reportDocument } from '../lib/reportPdf';
  import {
    computeRecoverable, tasksForIndustry, AREA_LABEL, METHODOLOGY_NOTE,
    type TaskArea, type RecoverableResult,
  } from '../lib/taskInventory';

  // The report is computed ENTIRELY in this component from the answers, so it
  // renders complete even if the backend is unreachable. The Worker call only
  // enhances the Analyst Note and routes the lead into HubSpot.
  // TODO(deploy): set to the deployed Worker URL.
  const PROXY_URL = 'https://inett-scan.nicholasdreyfus.workers.dev';
  const BOOKING_URL = 'https://meetings-na2.hubspot.com/ndreyfus/ai-risk-assessment';

  let capturedLead: any = null; // for booking prefill after unlock

  type Q = { id: string; label: string; type: 'single' | 'multi' | 'tasks' | 'headcount'; note?: string; options?: string[] };

  const QUESTIONS: Q[] = [
    { id: 'industry', label: 'What industry are you in?', type: 'single', options: ['Healthcare / Medical', 'Legal', 'Financial services', 'Professional services', 'Manufacturing', 'Retail / E-commerce', 'Real estate', 'Education / Schools', 'Nonprofit', 'Government / Public sector', 'Technology', 'Other'] },
    { id: 'size', label: 'How many people work in the organization?', type: 'single', options: ['Just me', '2-10', '11-25', '26-100', '101-250', '250+'] },
    { id: 'tools', label: 'Which AI tools is your team using today?', note: 'Select all that apply — skip if you’re not sure', type: 'multi', options: ['ChatGPT', 'Microsoft Copilot', 'Claude', 'Google Gemini', 'Perplexity', 'Grammarly AI', 'GitHub Copilot', 'Midjourney / DALL-E', 'Something custom / other', 'None that I know of'] },
    { id: 'ai', label: 'How is AI being used for work?', type: 'single', options: ['With clear rules and company accounts', 'We have a policy mostly in place — still finishing it', 'We just started putting rules together', 'On personal accounts — no rules', 'Not that I know of', 'We’ve banned it'] },
    { id: 'emppolicy', label: 'Do you have an AI & data policy every employee has signed?', type: 'single', options: ['Yes — every employee has signed one', 'We have one, but not everyone has signed', 'No signed policy yet', 'Not sure'] },
    { id: 'coaching', label: 'How is your team learning to use AI well?', note: 'Skill with AI is the difference between a toy and a tool', type: 'single', options: ['Every employee gets structured coaching', 'Some ad-hoc training here and there', 'They’re self-taught — figuring it out alone', 'They mostly don’t use it yet'] },
    { id: 'data', label: 'Does your organization handle any of the following?', note: 'Select all that apply', type: 'multi', options: ['Medical or health records', 'Card payments', 'Legal or financial documents', 'Government / CJIS / CMMC data', 'Children’s data', 'Personal data (PII) of customers', 'None of these'] },
    { id: 'vendorterms', label: 'Do your outside vendors have a written AI agreement with you?', note: 'Bookkeeper, marketing, IT — anyone who touches your data', type: 'single', options: ['Yes — it’s in our vendor contracts', 'No — we’ve never asked', 'Not sure'] },
    { id: 'insurance', label: 'Do you know whether your cyber insurance covers an AI-related incident?', type: 'single', options: ['Yes — we’ve confirmed it', 'We have cyber insurance but haven’t checked AI specifically', 'We don’t have cyber insurance', 'Not sure'] },
    { id: 'tasks', label: 'Which of these does your team still do by hand?', note: 'Tick all that apply — most people are surprised by the total', type: 'tasks' },
    { id: 'headcount', label: 'Roughly how many people spend time on this kind of work?', note: 'A rough number is fine — it’s how we size the opportunity', type: 'headcount' },
    { id: 'goal', label: 'What would make the biggest difference in the next 12 months?', type: 'single', options: ['Get governance & security right first', 'Roll AI out to the whole team', 'Build custom agents for our workflows', 'Cut time on repetitive work', 'Not sure yet'] },
  ];

  // Float the most-likely sensitive-data options to the top based on industry.
  const DATA_PRIORITY: Record<string, string[]> = {
    'Healthcare / Medical': ['Medical or health records', 'Personal data (PII) of customers'],
    'Legal': ['Legal or financial documents', 'Personal data (PII) of customers'],
    'Financial services': ['Legal or financial documents', 'Card payments'],
    'Professional services': ['Legal or financial documents', 'Personal data (PII) of customers'],
    'Manufacturing': ['Government / CJIS / CMMC data', 'Card payments'],
    'Retail / E-commerce': ['Card payments', 'Personal data (PII) of customers'],
    'Real estate': ['Legal or financial documents', 'Card payments'],
    'Education / Schools': ['Children’s data', 'Personal data (PII) of customers'],
    'Nonprofit': ['Personal data (PII) of customers', 'Card payments'],
    'Government / Public sector': ['Government / CJIS / CMMC data', 'Personal data (PII) of customers'],
    'Technology': ['Personal data (PII) of customers', 'Legal or financial documents'],
  };
  function orderedOptions(q: Q): string[] {
    const opts = q.options || [];
    if (q.id !== 'data') return opts;
    const none = 'None of these';
    const pri = (DATA_PRIORITY[answers.industry] || []).filter((o) => opts.indexOf(o) >= 0);
    const rest = opts.filter((o) => pri.indexOf(o) < 0 && o !== none);
    return pri.concat(rest).concat([none]);
  }

  // Prevalence estimates by segment (small / mid / enterprise) — framed as edge.
  type Prev = { s: number; m: number; e: number; edge: string };
  const PREV: Record<string, Prev> = {
    'SHADOW AI': { s: 68, m: 55, e: 39, edge: 'Govern it and you’re ahead of two-thirds of organizations your size.' },
    'COMPLIANCE': { s: 71, m: 57, e: 33, edge: 'Closing the gap before regulators or insurers look puts you ahead of most peers.' },
    'EMPLOYEE POLICY': { s: 81, m: 63, e: 37, edge: 'A signed policy is standard at enterprises and rare at your size — an easy edge.' },
    'ENABLEMENT': { s: 74, m: 61, e: 44, edge: 'Most teams never coach AISkill — the ones that do pull ahead fast.' },
    'WORKFLOWS': { s: 79, m: 66, e: 48, edge: 'Almost no one shares AI wins across the team. Doing it compounds quietly.' },
    'CUSTOM AGENTS': { s: 78, m: 66, e: 49, edge: 'Reclaiming these hours with agents is something most of your peers still haven’t done.' },
    'VENDOR AI TERMS': { s: 92, m: 84, e: 63, edge: 'Almost nobody has this. Having it is a genuine differentiator.' },
    'CYBER INSURANCE': { s: 74, m: 60, e: 34, edge: 'Knowing where you stand — and whether managed security can strengthen your coverage — beats most of the market.' },
    'THIRD-PARTY ACCESS': { s: 70, m: 57, e: 41, edge: 'Most organizations never check this — you’d be ahead of them.' },
  };
  // (typo guard) fix the ENABLEMENT edge string cleanly
  PREV['ENABLEMENT'].edge = 'Most teams never coach their people on AI — the ones that do pull ahead fast.';

  const MSGS = [
    { t: '[ INIT ] Connecting to Fortify AI scan engine...', c: 't-default' },
    { t: '[ SCAN ] Profiling organizational AI exposure...', c: 't-default' },
    { t: '[ SCAN ] Detecting shadow AI usage patterns...', c: 't-default' },
    { t: '[ SCAN ] Mapping data sensitivity & compliance...', c: 't-default' },
    { t: '[ SCAN ] Assessing team enablement & workflow spread...', c: 't-default' },
    { t: '[ SCAN ] Estimating automation & agent opportunity...', c: 't-default' },
    { t: '[ AI   ] Running readiness classification model...', c: 't-ai' },
    { t: '[ AI   ] Drafting executive analyst note...', c: 't-ai' },
    { t: '[ DONE ] Scan complete. Compiling findings...', c: 't-done' },
  ];

  type Finding = { w: number; sev: string; tag: string; head: string; detail: string; fix: string; locked?: boolean; prev?: Prev; gen?: number };

  // Genericness: higher = safe / plain to reveal publicly; lower = the specific,
  // higher-value analysis we keep behind a booked working session (so competitors
  // can't mine real insight from the public tool). Drives the CLIENT view only.
  // ENABLEMENT is a value proposition (a capability claim, not analysis of the
  // client's org), so it's safe — and good marketing — to reveal it in full.
  const GEN_BY_TAG: Record<string, number> = {
    'ENABLEMENT': 10, 'THIRD-PARTY ACCESS': 9, 'CYBER INSURANCE': 8, 'EMPLOYEE POLICY': 7,
    'WORKFLOWS': 5, 'CUSTOM AGENTS': 3, 'SHADOW AI': 3,
    'COMPLIANCE': 2, 'VENDOR AI TERMS': 1,
  };
  type Report = {
    score: number; band: string; shadowLevel: string; shadowSub: string; flags: string[];
    hoursVal: string; hoursSub: string; rec: RecoverableResult; findings: Finding[]; fallbackNote: string;
  };

  // Whole-dollar USD, e.g. $245,200. Used across the report and the PDF.
  const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');

  const answers: Record<string, any> = {};
  let currentQ = 0, scanProg = 0, blinkOn = true;
  let scanTick: any = null;
  let aiNote: string | null = null, unlocked = false;
  let currentReport: Report | null = null;
  const SHOWN_FINDINGS = 2;   // shown free, before the details form
  const FULL_FINDINGS = 3;    // full findings the client ever sees — 2 free + 1 on unlock (rest are redacted, no meeting)

  const $ = (id: string) => document.getElementById(id);

  // Blink
  setInterval(() => {
    blinkOn = !blinkOn;
    const st = $('scanStatusLine'); if (!st) return;
    const ph = st.dataset.phase || 'intro';
    if (ph === 'intro') st.textContent = blinkOn ? 'System ready' : ' System ready';
    const sh = $('scanHeader');
    if (ph === 'scanning' && sh) sh.textContent = blinkOn ? 'Analysis in progress' : ' Analysis in progress';
    const cu = $('cursor'); if (cu) cu.textContent = blinkOn ? '_' : ' ';
  }, 600);

  function show(id: string) {
    ['introScreen', 'questionScreen', 'scanScreen', 'resultsScreen'].forEach((s) => {
      const el = $(s); if (el) el.style.display = s === id ? 'block' : 'none';
    });
  }

  function setPhase(p: string) { const st = $('scanStatusLine'); if (st) st.dataset.phase = p; }

  $('startBtn')?.addEventListener('click', () => { setPhase('questions'); loadQ(); show('questionScreen'); });

  // Booking modal
  function bookingUrl(): string {
    let url = BOOKING_URL + '?embed=true';
    const l = capturedLead;
    if (l) {
      const parts = String(l.name || '').trim().split(/\s+/);
      const first = parts.shift() || '';
      const last = parts.join(' ');
      const p = new URLSearchParams();
      if (first) p.set('firstName', first);
      if (last) p.set('lastName', last);
      if (l.email) p.set('email', l.email);
      const qs = p.toString();
      if (qs) url += '&' + qs;
    }
    return url;
  }
  function openCal() {
    const f = $('calFrame') as HTMLIFrameElement | null;
    if (f) f.src = bookingUrl();
    $('calOverlay')?.classList.add('active');
  }
  $('bookBtn')?.addEventListener('click', openCal);
  $('meetingBookBtn')?.addEventListener('click', openCal);
  $('calClose')?.addEventListener('click', () => $('calOverlay')?.classList.remove('active'));
  $('calOverlay')?.addEventListener('click', function (this: HTMLElement, e) { if (e.target === this) this.classList.remove('active'); });

  // Areas that have at least one task ticked — drives which headcount rows show.
  function activeAreas(): TaskArea[] {
    const ids: string[] = answers.tasks || [];
    const areas: TaskArea[] = [];
    tasksForIndustry(answers.industry || 'Other').forEach((t) => {
      if (ids.indexOf(t.id) >= 0 && areas.indexOf(t.area) < 0) areas.push(t.area);
    });
    return areas;
  }

  function toggleTask(id: string) {
    const cur: string[] = answers.tasks || [];
    const i = cur.indexOf(id);
    answers.tasks = i >= 0 ? cur.filter((x: string) => x !== id) : cur.concat([id]);
    loadQ();
  }

  // The task inventory — vertical tasks float to the top, then the base 20.
  // Shown as a dense grid so the breadth of what AI can take off their plate is
  // the visual message.
  function renderTaskGrid() {
    const tasks = tasksForIndustry(answers.industry || 'Other');
    const sel: string[] = answers.tasks || [];
    ($('optionsList') as HTMLElement).innerHTML =
      '<div class="scan__taskGrid">' + tasks.map((t) => {
        const on = sel.indexOf(t.id) >= 0;
        return '<button class="scan__task' + (on ? ' selected' : '') + '" data-taskid="' + t.id + '">'
          + '<span class="scan__optMark">' + (on ? '▪' : '○') + '</span><span class="scan__taskLabel">' + t.label + '</span></button>';
      }).join('') + '</div>';
    document.querySelectorAll('#optionsList .scan__task').forEach((btn) => {
      btn.addEventListener('click', () => toggleTask((btn as HTMLElement).dataset.taskid || ''));
    });
  }

  // One "how many people do this work?" stepper per area they selected tasks in.
  // Deliberately NOT "how many people in accounting?" — a 6-person department
  // doesn't have 6 people doing AP, and asking the honest question gets the
  // honest multiplier.
  function renderHeadcount() {
    const areas = activeAreas();
    const hc = answers.headcount || (answers.headcount = {});
    const list = $('optionsList') as HTMLElement;
    if (!areas.length) {
      list.innerHTML = '<div class="scan__hcEmpty">No tasks selected — that’s fine, you can continue.</div>';
      return;
    }
    list.innerHTML = areas.map((area) => {
      const v = hc[area] || 1;
      return '<div class="scan__hcRow" data-area="' + area + '">'
        + '<span class="scan__hcLabel">' + AREA_LABEL[area] + '</span>'
        + '<span class="scan__hcCtl">'
        + '<button class="scan__hcBtn" data-step="-1" type="button" aria-label="fewer people">−</button>'
        + '<input class="scan__hcNum" type="number" min="1" max="500" value="' + v + '" inputmode="numeric" aria-label="people in ' + AREA_LABEL[area] + '">'
        + '<button class="scan__hcBtn" data-step="1" type="button" aria-label="more people">+</button>'
        + '</span></div>';
    }).join('');
    document.querySelectorAll('#optionsList .scan__hcRow').forEach((row) => {
      const area = (row as HTMLElement).dataset.area as TaskArea;
      const input = row.querySelector('.scan__hcNum') as HTMLInputElement;
      const setVal = (n: number) => { const c = Math.max(1, Math.min(500, Math.round(n) || 1)); input.value = String(c); hc[area] = c; };
      input.addEventListener('input', () => { const n = Number(input.value); if (Number.isFinite(n) && input.value !== '') hc[area] = Math.max(1, Math.min(500, Math.round(n))); });
      input.addEventListener('blur', () => setVal(Number(input.value)));
      row.querySelectorAll('.scan__hcBtn').forEach((b) =>
        b.addEventListener('click', () => setVal((hc[area] || 1) + Number((b as HTMLElement).dataset.step))));
    });
  }

  function loadQ() {
    const q = QUESTIONS[currentQ];
    ($('progressFill') as HTMLElement).style.width = ((currentQ / QUESTIONS.length) * 100) + '%';
    ($('qCount') as HTMLElement).textContent = 'Q ' + (currentQ + 1) + ' / ' + QUESTIONS.length;
    ($('qLabel') as HTMLElement).textContent = q.label;
    const ne = $('qNote') as HTMLElement;
    if (q.note) { ne.textContent = q.note; ne.style.display = 'block'; } else { ne.style.display = 'none'; }
    ($('qDots') as HTMLElement).innerHTML = QUESTIONS.map((_, i) =>
      '<div class="scan__qDot' + (i < currentQ ? ' done' : i === currentQ ? ' active' : '') + '"></div>').join('');
    const nb = $('multiNextBtn') as HTMLElement;

    if (q.type === 'tasks') {
      renderTaskGrid();
      const n = (answers.tasks || []).length;
      nb.style.display = 'flex';
      nb.innerHTML = (n > 0 ? 'Continue (' + n + ' selected) ' : 'Skip ') + '<span aria-hidden="true">→</span>';
      nb.onclick = advanceQ;
      return;
    }
    if (q.type === 'headcount') {
      renderHeadcount();
      nb.style.display = 'flex';
      nb.innerHTML = 'Continue <span aria-hidden="true">→</span>';
      nb.onclick = advanceQ;
      return;
    }

    const sel = answers[q.id] || (q.type === 'multi' ? [] : '');
    ($('optionsList') as HTMLElement).innerHTML = orderedOptions(q).map((opt) => {
      const isSel = q.type === 'multi' ? sel.indexOf(opt) >= 0 : sel === opt;
      return '<button class="scan__opt' + (isSel ? ' selected' : '') + '" data-val="' + encodeURIComponent(opt) + '">'
        + '<span class="scan__optMark">' + (isSel ? '▪' : '○') + '</span>' + opt + '</button>';
    }).join('');
    document.querySelectorAll('#optionsList .scan__opt').forEach((btn) => {
      btn.addEventListener('click', () => handleAnswer(decodeURIComponent((btn as HTMLElement).dataset.val || '')));
    });
    if (q.type === 'multi') {
      nb.style.display = 'flex';
      nb.innerHTML = sel.length > 0 ? 'Continue (' + sel.length + ' selected) <span aria-hidden="true">→</span>' : 'Skip <span aria-hidden="true">→</span>';
      nb.onclick = advanceQ;
    } else { nb.style.display = 'none'; }
  }

  const EXCLUSIVE: Record<string, string> = { data: 'None of these', tools: 'None that I know of' };

  function handleAnswer(val: string) {
    const q = QUESTIONS[currentQ];
    if (q.type === 'multi') {
      let cur = answers[q.id] || [];
      const none = EXCLUSIVE[q.id];
      if (none && val === none) {
        answers[q.id] = cur.indexOf(val) >= 0 ? [] : [none];
      } else {
        cur = cur.filter((v: string) => v !== none);
        const idx = cur.indexOf(val);
        answers[q.id] = idx >= 0 ? cur.filter((v: string) => v !== val) : cur.concat([val]);
      }
      loadQ();
    } else {
      answers[q.id] = val;
      setTimeout(advanceQ, 200);
    }
  }

  function advanceQ() {
    if (currentQ < QUESTIONS.length - 1) { currentQ++; loadQ(); }
    else { startScan(); }
  }

  /* ===== Deterministic report engine ===== */
  const FLAG_MAP: Record<string, string> = {
    'Medical or health records': 'HIPAA — health data',
    'Card payments': 'PCI-DSS — card payments',
    'Legal or financial documents': 'Confidentiality — legal & financial records',
    'Government / CJIS / CMMC data': 'CMMC / CJIS — government work',
    'Children’s data': 'COPPA / FERPA — children’s data',
    'Personal data (PII) of customers': 'GDPR / CCPA — personal data',
  };

  function computeReport(a: Record<string, any>): Report {
    const sensitive = (a.data || []).filter((d: string) => d !== 'None of these');
    const flags = sensitive.map((d: string) => FLAG_MAP[d]).filter(Boolean);
    const aiManaged = a.ai === 'With clear rules and company accounts';
    const aiMostly = a.ai === 'We have a policy mostly in place — still finishing it';
    const aiGoverned = aiManaged || aiMostly;
    const toolList = (a.tools || []).filter((t: string) => t !== 'None that I know of');

    // Shadow AI (0-30)
    let shadow = a.ai === 'On personal accounts — no rules' ? 26
      : a.ai === 'Not that I know of' ? 18
      : a.ai === 'We just started putting rules together' ? 16
      : aiMostly ? 9
      : a.ai === 'We’ve banned it' ? 12
      : aiManaged ? 5 : 14;
    if (sensitive.length && !aiGoverned) shadow = Math.min(30, shadow + 4);
    if (toolList.length >= 3 && !aiGoverned) shadow = Math.min(30, shadow + 2);
    const empSigned = a.emppolicy === 'Yes — every employee has signed one';
    const empNone = a.emppolicy === 'No signed policy yet' || a.emppolicy === 'Not sure';
    if (empNone && !aiManaged) shadow = Math.min(30, shadow + 2);

    // Compliance (0-18)
    const compliance = flags.length ? (aiGoverned ? Math.min(9, flags.length * 3) : Math.min(18, flags.length * 5)) : 0;

    // Enablement gap (0-16) — the coaching pillar.
    // Self-taught is the HIGHEST exposure here, not "not using it yet": a team
    // using AI at scale with no guardrails is actively creating risk, whereas
    // "we don't really use it" almost always means the org isn't tracking usage
    // and simply can't see what's already happening (that invisibility is
    // scored on the usage axis above, as shadow AI). Previously this was
    // inverted — "mostly don't use yet" (14) outscored self-taught (12), so
    // not adopting rated as riskier than adopting badly.
    const enable = a.coaching === 'They’re self-taught — figuring it out alone' ? 14
      : a.coaching === 'They mostly don’t use it yet' ? 8
      : a.coaching === 'Some ad-hoc training here and there' ? 6
      : 3;

    // Insurance + vendor exposure (0-14)
    let insureExp = a.insurance === 'We don’t have cyber insurance' ? 8
      : a.insurance === 'We have cyber insurance but haven’t checked AI specifically' ? 6
      : a.insurance === 'Not sure' ? 6 : 1;
    insureExp += a.vendorterms === 'No — we’ve never asked' ? 4 : a.vendorterms === 'Not sure' ? 3 : 0;
    insureExp = Math.min(14, insureExp);

    // Agent / automation opportunity (0-12), derived from the task inventory —
    // the recoverable weekly hours the tasks they ticked add up to (capped per
    // area so it stays believable). See lib/taskInventory.
    const rec = computeRecoverable(a.tasks || [], a.headcount || {}, a.industry || 'Other');
    const agentOpp = rec.weeklyHigh >= 40 ? 12 : rec.weeklyHigh >= 20 ? 9 : rec.weeklyHigh >= 8 ? 6 : rec.weeklyHigh > 0 ? 3 : 2;

    // Risk floors. A single catastrophic gap should establish a MINIMUM score
    // regardless of how the additive components land — one client file pasted
    // into a free tool is a material incident whether or not the org scores
    // well elsewhere, and the additive model was diluting exactly that (a
    // maxed-out shadow-AI profile still only reached 71). max(additive, floor)
    // keeps the additive score discriminating ABOVE the floor.
    // Approved 2026-08-18 — see fortify-scan-v2-spec.
    //   shadow AI (confirmed OR untracked/invisible) OR vendors never vetted -> 75
    //   both -> 85 ; both + no signed employee policy -> 88
    //   +4 (cap 95) if regulated data is in play ; 90+ stays reserved for
    //   genuinely worst-case so the number keeps meaning something.
    const shadowUngoverned = a.ai === 'On personal accounts — no rules' || a.ai === 'Not that I know of';
    const vendorGap = a.vendorterms === 'No — we’ve never asked' || a.vendorterms === 'Not sure';
    let floor = 0;
    if (shadowUngoverned || vendorGap) floor = 75;
    if (shadowUngoverned && vendorGap) floor = 85;
    if (shadowUngoverned && vendorGap && empNone) floor = 88;
    if (floor && sensitive.length) floor = Math.min(95, floor + 4);

    const score = Math.max(4, Math.min(100, Math.max(shadow + compliance + enable + insureExp + agentOpp, floor)));
    const band = score >= 70 ? 'HIGH' : score >= 45 ? 'ELEVATED' : score >= 25 ? 'MODERATE' : 'LOW';

    const shadowLevel = shadow >= 22 ? 'HIGH' : shadow >= 12 ? 'MODERATE' : 'LOW';
    const shadowSub = a.ai === 'On personal accounts — no rules' ? (toolList.length ? toolList.length + ' AI tools confirmed, on personal accounts with no rules' : 'AI in use on personal accounts with no usage rules')
      : a.ai === 'We just started putting rules together' ? 'You’ve started on rules — finishing them is what closes the gap'
      : aiMostly ? 'Policy mostly in place — finishing and enforcing it locks it in'
      : a.ai === 'Not that I know of' ? 'Unmonitored — most teams are already using AI quietly'
      : a.ai === 'We’ve banned it' ? 'Bans push AI use underground rather than stopping it'
      : aiManaged ? 'Usage governed by clear rules — keep them current' : 'Unknown usage profile';

    const hoursVal = rec.weeklyHigh > 0 ? rec.weeklyLow + '–' + rec.weeklyHigh + ' hrs' : 'Untracked';
    const hoursSub = rec.weeklyHigh > 0 ? 'Up to ' + usd(rec.annualHigh) + '/yr recoverable with automation' : 'Pick the tasks your team does by hand to size this';

    const cands: Finding[] = [];

    // ENABLEMENT / COACHING (pillar 1)
    if (a.coaching && a.coaching !== 'Every employee gets structured coaching') {
      cands.push({
        w: enable + 5, sev: a.coaching === 'They mostly don’t use it yet' ? 'warn' : 'info', tag: 'ENABLEMENT',
        head: a.coaching === 'They mostly don’t use it yet'
          ? 'Your team has room to get far more value from AI than it does today.'
          : 'Your team is largely self-taught with AI, so it isn’t working nearly as effectively for them as it could.',
        detail: a.coaching === 'They mostly don’t use it yet'
          ? 'The gap between a team that uses AI well and one that doesn’t is becoming a real competitive difference. With the right guidance, employees move well beyond basic copy-paste use.'
          : 'Self-taught users tend to write weaker prompts and receive poorer-quality responses, which can quietly lead to work being done incorrectly. Across large organizations — including 10,000+ employee enterprises — the majority of users experienced this before structured coaching was in place.',
        fix: 'A prompt coach for every employee raises the quality and consistency of what AI produces. Published results for this coaching approach show up to 73% better AI outputs and roughly 65% lower risk of a poor result — with up to 80% stronger prompts and about 54% fewer tokens.',
      });
    }

    // SHADOW AI
    if (!aiManaged) {
      cands.push({
        w: shadow, sev: (sensitive.length && !aiGoverned) ? 'danger' : 'warn', tag: 'SHADOW AI',
        head: a.ai === 'We’ve banned it' ? 'Your AI ban isn’t stopping AI use — it’s hiding it from you.'
          : a.ai === 'On personal accounts — no rules' ? (toolList.length ? 'Your team is already on ' + toolList.length + ' AI tools — through personal accounts, with no rules.' : 'Your team uses AI through personal accounts with no rules about what goes into it.')
          : aiMostly ? 'Your AI rules are almost there — the win is finishing and enforcing them.'
          : a.ai === 'We just started putting rules together' ? 'You’ve started on AI rules — until they’re finished, the exposure stays open.'
          : 'AI is almost certainly in use at your organization — just not where you can see it.',
        detail: (aiGoverned
          ? 'Even a mostly-complete policy leaves gaps while it’s unfinished — employees still paste real work into free AI tools'
          : 'Employees paste real work into free AI tools — customer details, pricing, contracts')
          + (sensitive.length ? ', and in your case potentially ' + sensitive.join(', ').toLowerCase() : '')
          + '. Public tools can retain and train on that data, outside any agreement that protects you.',
        fix: (aiMostly || a.ai === 'We just started putting rules together')
          ? 'We help you finish the AI usage policy and move the team onto governed, business-grade accounts — so the rules you started actually hold.'
          : 'A one-page AI usage policy plus governed, business-grade AI accounts gives your team the productivity without the exposure.',
      });
    }

    // COMPLIANCE
    if (flags.length && !aiGoverned) {
      cands.push({
        w: flags.length * 7 + 4, sev: 'danger', tag: 'COMPLIANCE',
        head: 'Your data obligations and your AI usage haven’t met each other yet.',
        detail: 'You handle ' + sensitive.join(', ').toLowerCase() + ', which commonly brings obligations under frameworks like ' + flags.map((f: string) => f.split(' — ')[0]).join(', ')
          + '. Where those apply, ungoverned AI use with this kind of data is often the first gap regulators, insurers, and opposing counsel look at.',
        fix: 'Access controls, an approved-tools list, and monitoring close the gap — usually without slowing anyone down.',
      });
    }

    // WORKFLOWS DON'T SPREAD (pillar 2)
    if (toolList.length >= 2 || a.goal === 'Roll AI out to the whole team') {
      cands.push({
        w: 8, sev: 'info', tag: 'WORKFLOWS',
        head: 'When one person figures out a great AI workflow, does everyone doing that job get it?',
        detail: 'In most organizations, one sharp employee builds a genuinely useful AI workflow — and it dies on their laptop. Everyone else keeps doing it the slow way, and the win never compounds.',
        fix: 'We capture the workflows and skills that work and spread them to everyone in that role — so one person’s win becomes the whole team’s baseline.',
      });
    }

    // CUSTOM AGENTS (pillar 3)
    const busyW = rec.weeklyHigh >= 40 ? 14 : rec.weeklyHigh >= 20 ? 10 : rec.weeklyHigh >= 8 ? 6 : rec.weeklyHigh > 0 ? 4 : 2;
    if (busyW >= 6 || a.goal === 'Build custom agents for our workflows') {
      cands.push({
        w: busyW, sev: 'info', tag: 'CUSTOM AGENTS',
        head: rec.weeklyHigh > 0
          ? 'Your team is spending up to ' + rec.weeklyHigh + ' hours a week — ' + usd(rec.annualHigh) + ' a year — on work a custom agent should do.'
          : 'The repetitive work your team does by hand is exactly what agents are built for.',
        detail: 'Invoice processing, data entry, follow-up, resume screening, and copy-paste between systems are exactly the tasks a purpose-built agent removes first — and the tasks your best people resent most. Estimates are deliberately conservative; the real number is usually higher.',
        fix: 'We build custom agents with you — starting with the task your team hates most — so the hours go back into work that actually earns.',
      });
    }

    // EMPLOYEE POLICY
    if (!empSigned && a.emppolicy) {
      cands.push({
        w: empNone ? 13 : 9, sev: empNone ? 'warn' : 'info', tag: 'EMPLOYEE POLICY',
        head: empNone ? 'There’s no signed AI & data policy your team is actually held to.'
          : 'You have a policy — but not everyone has signed it, so it’s hard to enforce.',
        detail: 'A policy nobody signed is a suggestion, not a control. If an employee leaks data through an AI tool, “we told them not to” doesn’t hold up with a regulator, an insurer, or in court — a signed acknowledgment does.',
        fix: 'We produce a plain-language AI & data use policy written for your organization, ready for every employee to sign — documented, acknowledged, and enforceable.',
      });
    }

    // Universal findings
    cands.push({
      w: 8, sev: 'warn', tag: 'THIRD-PARTY ACCESS',
      head: 'Your vendors touch your data — do you know if they run it through their own AI?',
      detail: 'Your bookkeeper, marketing help, IT contractor, and software vendors all handle your data. Any one of them pasting it into their own AI tools is exposure you inherit but can’t see — and their mistake becomes your problem.',
      fix: 'We map who can reach what, and help you set the expectation that your data never goes into anyone’s ungoverned AI — yours or theirs.',
    });
    cands.push({
      w: 7, sev: 'info', tag: 'CYBER INSURANCE',
      head: 'Even a clean setup: does your cyber policy actually cover an AI-related incident?',
      detail: 'Many cyber policies written before the last renewal cycle have silent gaps or exclusions for AI-driven data exposure. As a Lloyd’s of London cyber-insurance partner, i-NETT can help you see where you stand — and because our managed security lowers risk, the organizations we manage can qualify for stronger coverage and better pricing.',
      fix: 'We check your posture against how insurers now write AI exclusions, so you know exactly where you stand — and where managed security could strengthen your position — before you ever need to file.',
    });

    cands.sort((x, y) => y.w - x.w);
    const findings = cands.slice(0, 5);

    // Hero locked finding — always present, revealed only after the lead form.
    const vendorYes = a.vendorterms === 'Yes — it’s in our vendor contracts';
    findings.push({
      w: 0, locked: true, sev: vendorYes ? 'warn' : 'danger', tag: 'VENDOR AI TERMS',
      head: vendorYes
        ? 'You have vendor agreements — but do they actually mention AI, or just data?'
        : 'Have the vendors who touch your data signed anything about using AI with it?',
      detail: vendorYes
        ? 'Most vendor contracts signed before the last year or two govern data handling but say nothing about AI specifically. If your bookkeeper or agency runs your data through their own AI tools, an older data clause may not cover it — and the liability quietly drifts back to you.'
        : 'This is the one almost nobody has covered. When a contractor or vendor runs your customer data, financials, or IP through an AI tool, whose liability is that? Without a signed agreement that specifically governs AI use of your data, the answer is usually you. It is the most overlooked exposure we find — and the easiest to close on paper.',
      fix: 'We give you a plain-language AI data clause to add to your vendor agreements, so any third party handling your data is explicitly on the hook for how they use it. This is the first thing we’d put in front of you on a call.',
    });

    findings.forEach((f) => { if (PREV[f.tag]) f.prev = PREV[f.tag]; f.gen = GEN_BY_TAG[f.tag] ?? 4; });

    const industryPhrase = a.industry && a.industry !== 'Other' ? 'a ' + a.industry.toLowerCase() + ' organization' : 'an organization';
    const fallbackNote = 'For ' + industryPhrase + ' your size, this profile is '
      + (band === 'LOW' ? 'in good shape — the findings above are refinements, not alarms' : band === 'MODERATE' ? 'typical, and typical means fixable'
        : 'carrying real, addressable exposure') + '. '
      + (findings.length ? 'The place to start is the top finding: ' + findings[0].head.toLowerCase().replace(/\.$/, '') + '. ' : '')
      + 'None of this requires a big IT project — the first Fortify AI deployment is usually live within 30 days, and a free 30-minute review turns this report into that plan.';

    return { score, band, shadowLevel, shadowSub, flags, hoursVal, hoursSub, rec, findings, fallbackNote };
  }

  /* ===== Scan theater + AI note ===== */
  function startScan() {
    setPhase('scanning');
    show('scanScreen');
    scanProg = 0;
    scanTick = setInterval(() => {
      scanProg = Math.min(scanProg + 1.6, 96);
      ($('scanFill') as HTMLElement).style.width = scanProg + '%';
      ($('scanPct') as HTMLElement).textContent = Math.round(scanProg) + '% complete';
    }, 80);
    MSGS.forEach((msg, i) => {
      setTimeout(() => {
        const term = $('terminal'); const cur = $('cursor');
        if (!term || !cur) return;
        const div = document.createElement('div');
        div.className = msg.c; div.textContent = msg.t;
        term.insertBefore(div, cur);
      }, i * 550 + 400);
    });

    const report = computeReport(answers);
    currentReport = report;
    fetchAnalystNote(report);

    setTimeout(() => {
      clearInterval(scanTick);
      ($('scanFill') as HTMLElement).style.width = '100%';
      ($('scanPct') as HTMLElement).textContent = '100% complete';
      setTimeout(() => showResults(report), 500);
    }, MSGS.length * 550 + 900);
  }

  function fetchAnalystNote(report: Report) {
    const controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
    if (controller) setTimeout(() => controller.abort(), 12000);
    fetch(PROXY_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      signal: controller ? controller.signal : undefined,
      body: JSON.stringify({
        answers,
        computed: {
          score: report.score, band: report.band, shadowLevel: report.shadowLevel,
          flags: report.flags, hours: report.hoursVal,
          findings: report.findings.map((f) => ({ tag: f.tag, headline: f.head })),
        },
      }),
    }).then((res) => { if (!res.ok) throw new Error('API ' + res.status); return res.json(); })
      .then((data) => {
        if (data && typeof data.analystNote === 'string' && data.analystNote.length > 40) {
          aiNote = data.analystNote;
          if (unlocked) {
            const el = $('analystText') as HTMLElement;
            el.style.opacity = '0';
            setTimeout(() => { el.textContent = aiNote as string; el.style.opacity = '1'; }, 400);
          }
        }
      }).catch(() => { /* fallback covers this */ });
  }

  function renderFinding(f: Finding, i: number): string {
    const fc = f.sev === 'danger' ? 'scan__finding--danger' : f.sev === 'info' ? 'scan__finding--info' : 'scan__finding--warn';
    const ft = f.sev === 'danger' ? 'scan-tag--danger' : f.sev === 'info' ? 'scan-tag--info' : 'scan-tag--warn';
    return '<div class="scan__finding ' + fc + '">'
      + '<div class="scan__findingTop"><span class="scan-tag ' + ft + '">' + f.tag + '</span><span class="scan__findingNum">FINDING 0' + (i + 1) + '</span></div>'
      + '<div class="scan__findingHead">' + f.head + '</div>'
      + '<div class="scan__findingDetail">' + f.detail + '</div>'
      + '<div class="scan__findingFix"><strong>What to do:</strong> ' + f.fix + '</div>'
      + (f.prev
        ? '<div class="scan__prev"><div class="scan__prevLead">How common is this gap?</div>'
          + prevRow('Small businesses', 'sm', f.prev.s)
          + prevRow('Mid-sized', 'mid', f.prev.m)
          + prevRow('Enterprises', 'ent', f.prev.e)
          + '<div class="scan__prevEdge">' + f.prev.edge + '</div></div>'
        : '')
      + '</div>';
  }

  function prevRow(label: string, key: string, pct: number): string {
    return '<div class="scan__prevRow">'
      + '<span class="scan__prevLabel">' + label + '</span>'
      + '<span class="scan__prevBar"><span class="scan__prevFill scan__prevFill--' + key + '" style="width:' + pct + '%"></span></span>'
      + '<span class="scan__prevPct scan__prevPct--' + key + '">' + pct + '%</span>'
      + '</div>';
  }

  function showResults(r: Report) {
    const color = r.band === 'HIGH' ? '#C13030' : r.band === 'ELEVATED' ? '#B86E00' : r.band === 'MODERATE' ? '#C99700' : '#0F8B5F';
    const arcLen = 220, filled = (r.score / 100) * arcLen;
    const angle = -180 + (r.score / 100) * 180, rad = angle * Math.PI / 180;
    const cx = 82 + 70 * Math.cos(rad), cy = 88 + 70 * Math.sin(rad);
    ($('meterArc') as any).style.stroke = color;
    ($('meterArc') as any).setAttribute('stroke-dashoffset', String(arcLen - filled));
    ($('meterDot') as any).setAttribute('cx', String(cx));
    ($('meterDot') as any).setAttribute('cy', String(cy));
    ($('meterDot') as any).style.fill = color;
    ($('meterScore') as any).textContent = String(r.score);
    ($('meterScore') as any).style.fill = color;
    ($('meterLabel') as any).textContent = r.band;
    ($('meterLabel') as any).style.fill = color;
    const tc = r.band === 'HIGH' ? 'scan-tag--danger' : r.band === 'ELEVATED' ? 'scan-tag--warn' : r.band === 'MODERATE' ? 'scan-tag--warn' : 'scan-tag--ok';
    const rt = $('riskTag') as HTMLElement; rt.className = 'scan-tag ' + tc; rt.textContent = r.band;

    ($('shadowEst') as HTMLElement).textContent = r.shadowLevel;
    ($('shadowSub') as HTMLElement).textContent = r.shadowSub;
    ($('compFlags') as HTMLElement).textContent = String(r.flags.length);
    ($('compSub') as HTMLElement).textContent = r.flags.length ? r.flags.join(' · ') : 'No regulated data categories reported';
    ($('hoursVal') as HTMLElement).textContent = r.hoursVal;
    ($('hoursSub') as HTMLElement).textContent = r.hoursSub;

    // Recoverable hero + itemized "where the week goes" breakdown.
    const rec = r.rec;
    const recBox = $('recoverBox') as HTMLElement;
    if (rec && rec.weeklyHigh > 0) {
      ($('recoverHero') as HTMLElement).textContent = 'Up to ' + usd(rec.annualHigh) + ' / year';
      ($('recoverSub') as HTMLElement).textContent =
        rec.weeklyLow + '–' + rec.weeklyHigh + ' hours a week, at $' + rec.rate + '/hr fully loaded — a deliberately conservative estimate.';
      ($('recoverList') as HTMLElement).innerHTML = rec.byTask
        .filter((t) => t.high > 0)
        .map((t) => '<div class="scan__recoverItem"><span>' + t.label + '</span><span>up to ' + t.high + ' hrs/wk</span></div>')
        .join('');
      ($('recoverNote') as HTMLElement).textContent = METHODOLOGY_NOTE;
      recBox.style.display = 'block';
    } else {
      recBox.style.display = 'none';
    }

    const cv = genericView(r.findings);
    const shown = cv.findings.slice(0, SHOWN_FINDINGS);
    const hidden = [...cv.findings.slice(SHOWN_FINDINGS), ...cv.teasers, ...cv.locked];
    ($('findingsList') as HTMLElement).innerHTML = shown.map((f, i) => renderFinding(f, i)).join('');

    ($('lockedLabel') as HTMLElement).textContent = hidden.length
      ? ('+' + hidden.length + ' MORE FINDING' + (hidden.length > 1 ? 'S' : '') + ' IN YOUR REPORT')
      : 'YOUR ANALYST NOTE';
    ($('lockedCards') as HTMLElement).innerHTML = hidden.map((f, i) => {
      const ft = f.sev === 'danger' ? 'scan-tag--danger' : f.sev === 'info' ? 'scan-tag--info' : 'scan-tag--warn';
      return '<div class="scan__locked"><div class="scan__lockedGhost">'
        + '<div style="display:flex;justify-content:space-between;margin-bottom:7px"><span class="scan-tag ' + ft + '">' + f.tag + '</span><span class="scan__findingNum">FINDING 0' + (i + 1 + SHOWN_FINDINGS) + '</span></div>'
        + '<div class="scan__ghostBar" style="width:72%"></div><div class="scan__ghostBar" style="width:88%"></div><div class="scan__ghostBar" style="width:55%"></div></div>'
        + '<div class="scan__lockedOverlay"><span style="font-size:15px">🔒</span><span class="scan__lockLabel">UNLOCKS WITH YOUR FULL REPORT</span></div></div>';
    }).join('');

    show('resultsScreen');
    const st = $('scanStatusLine') as HTMLElement; st.textContent = 'Scan complete'; st.dataset.phase = 'results';
    setTimeout(() => {
      const cta = $('ctaSection') as HTMLElement;
      cta.style.opacity = '1'; cta.style.transform = 'translateY(0)';
    }, 900);
  }

  /* ===== Lead gate ===== */
  document.querySelectorAll('#leadChips .scan__chip').forEach((b) => {
    b.addEventListener('click', () => (b as HTMLElement).classList.toggle('is-on'));
  });

  $('unlockBtn')?.addEventListener('click', () => {
    const name = $('leadName') as HTMLInputElement, company = $('leadCompany') as HTMLInputElement,
      website = $('leadWebsite') as HTMLInputElement, email = $('leadEmail') as HTMLInputElement, cell = $('leadCell') as HTMLInputElement;
    const err = $('gateError') as HTMLElement;
    [name, company, email, cell].forEach((el) => el.classList.remove('invalid'));
    const problems: string[] = [];
    if (!name.value.trim()) { problems.push('name'); name.classList.add('invalid'); }
    if (!company.value.trim()) { problems.push('company'); company.classList.add('invalid'); }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim())) { problems.push('a valid email'); email.classList.add('invalid'); }
    if (cell.value.replace(/\D/g, '').length < 7) { problems.push('cell phone'); cell.classList.add('invalid'); }
    if (problems.length) {
      err.textContent = 'Please add your ' + problems.join(', ').replace(/, ([^,]*)$/, ' and $1') + '.';
      err.style.display = 'block';
      return;
    }
    err.style.display = 'none';
    const contact = Array.from(document.querySelectorAll('#leadChips .scan__chip.is-on')).map((b) => (b as HTMLElement).dataset.c);
    const lead = { name: name.value.trim(), company: company.value.trim(), website: website.value.trim(), email: email.value.trim(), cell: cell.value.trim(), contact };
    capturedLead = lead;
    unlockReport();
    submitLead(lead);
  });

  // Score badge: red/amber/green traffic-light read on the finding's risk,
  // shown on every "rest of your report" box so a glance signals good vs. bad
  // news — without revealing what the finding actually is.
  function scoreBadgeClass(f: Finding): string {
    return f.sev === 'danger' ? 'scan__scoreBadge--high' : f.sev === 'warn' ? 'scan__scoreBadge--mid' : 'scan__scoreBadge--low';
  }
  function scoreBadge(f: Finding): string {
    return '<span class="scan__scoreBadge ' + scoreBadgeClass(f) + '">' + riskScore(f) + '%</span>';
  }

  // Redacted item: full-size box, same treatment throughout — no headline
  // teased anywhere, no shrinking these down. These are
  // the higher-value findings we walk through in a session; showing them at
  // full size (instead of a small chip) avoids reading as if we're hiding
  // something, while the copy explains exactly why it's blanked out.
  function renderRedacted(f: Finding): string {
    const ft = f.sev === 'danger' ? 'scan-tag--danger' : f.sev === 'info' ? 'scan-tag--info' : 'scan-tag--warn';
    const company = (capturedLead && capturedLead.company) || 'your organization';
    return '<div class="scan__teaser scan__teaser--redacted">'
      + '<div class="scan__findingTop"><span class="scan-tag ' + ft + '">' + f.tag + '</span>' + scoreBadge(f) + '</div>'
      + '<div class="scan__redactedBar" aria-hidden="true"></div>'
      + '<div class="scan__redactedBar scan__redactedBar--short" aria-hidden="true"></div>'
      + '<div class="scan__teaserFoot">🔒 Redacted to protect ' + company + '&rsquo;s privacy and security. You&rsquo;ll receive this finding in full &mdash; completely unredacted &mdash; in your PDF after our working session.</div>'
      + '</div>';
  }

  function unlockReport() {
    unlocked = true;
    const r = currentReport as Report;
    const cv = genericView(r.findings);
    ($('findingsList') as HTMLElement).innerHTML = cv.findings.map((f, i) => renderFinding(f, i)).join('');
    ($('shownLabel') as HTMLElement).textContent = 'YOUR TOP ' + cv.findings.length + ' PRIORITIES — AND WHAT TO DO ABOUT EACH';
    ($('gateSection') as HTMLElement).style.display = 'none';
    const rest = cv.locked.map((f) => renderRedacted(f)).join('');
    if (rest) {
      ($('meetingLabel') as HTMLElement).textContent = 'THE REST OF YOUR REPORT — ' + cv.locked.length + ' MORE';
      ($('meetingCards') as HTMLElement).innerHTML = rest;
      ($('meetingGate') as HTMLElement).style.display = 'block';
      ($('ctaSection') as HTMLElement).style.display = 'none';
    }
    const box = $('analystBox') as HTMLElement;
    ($('analystText') as HTMLElement).textContent = aiNote || r.fallbackNote;
    box.style.display = 'block';
    ($('findingsList') as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ---- Map a scan Finding to the design-handoff ReportFinding shape ----
  function toReportFinding(f: Finding, idx: number): ReportFinding {
    const peers: Peer[] = f.prev
      ? [{ label: 'Small business', pct: f.prev.s }, { label: 'Mid-sized', pct: f.prev.m }, { label: 'Enterprise', pct: f.prev.e }]
      : [{ label: 'Small business', pct: 0 }, { label: 'Mid-sized', pct: 0 }, { label: 'Enterprise', pct: 0 }];
    return {
      category: f.tag,
      index: 'FINDING 0' + (idx + 1),
      headline: f.head,
      body: f.detail,
      action: f.fix.replace(/(\d+%)/g, '<strong style="font-weight:600;">$1</strong>'),
      peers,
    };
  }

  function severityBandFor(band: string): string {
    return band === 'HIGH' ? 'SEVERE' : band; // ELEVATED | MODERATE | LOW pass through
  }
  function severityNoteFor(band: string): string {
    return band === 'HIGH' ? 'Action recommended now' : band === 'ELEVATED' ? 'Action recommended this quarter'
      : band === 'MODERATE' ? 'Worth addressing in the next few months' : 'In good shape — keep monitoring';
  }
  function scanIdFor(lead: any): string {
    const d = new Date();
    const yyyy = d.getFullYear(), mm = String(d.getMonth() + 1).padStart(2, '0'), dd = String(d.getDate()).padStart(2, '0');
    const initials = String(lead.company || 'SCN').toUpperCase().replace(/[^A-Z ]/g, '').split(/\s+/).filter(Boolean).map((w: string) => w[0]).slice(0, 3).join('') || 'SCN';
    return `${yyyy}-${mm}${dd}-${initials}`;
  }

  // Base ReportData shared by the client link and the internal PDF — only the
  // findings/lockedAreas differ between the two views.
  function baseReportData(lead: any, r: Report, note: string): ReportData {
    const date = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    const shadowRed = r.shadowLevel === 'HIGH';
    return {
      scanId: scanIdFor(lead),
      preparedFor: { name: lead.name || '', company: lead.company || '', email: lead.email || '', phone: lead.cell || '', website: lead.website || '', industry: answers.industry || '', sizeBand: answers.size || '' },
      date,
      exposureScore: r.score,
      severityBand: severityBandFor(r.band),
      severityNote: severityNoteFor(r.band),
      metrics: [
        { label: 'SHADOW AI', value: r.shadowLevel, accent: shadowRed ? '#B3261E' : '#C77A0A', valueColor: shadowRed ? '#B3261E' : '#C77A0A', blurb: r.shadowSub },
        { label: 'COMPLIANCE FLAGS', value: String(r.flags.length), accent: r.flags.length ? '#C77A0A' : '#12A5DB', valueColor: r.flags.length ? '#C77A0A' : '#0B2440', blurb: r.flags.length ? r.flags.join(' · ') : 'No regulated data categories reported' },
        { label: 'RECOVERABLE HRS / WK', value: r.hoursVal, accent: '#12A5DB', valueColor: '#0B2440', blurb: r.hoursSub },
      ],
      findings: [],
      lockedAreas: [],
      analystNote: note,
      cta: { headline: 'These need to be walked through, not skimmed.', body: 'In a free 30-minute working session we go through each finding, what it means for you, and what to do first.', url: bookingUrl(), company: lead.company || '' },
      scanInputs: answerRows().map((a) => ({ question: a.label, answer: a.value })),
      preparedBy: { name: 'Nick Dreyfus', title: 'Vice President, Business Development · i-NETT / Fortify AI', contactLine: 'i-nett.ai · (858) 337-2866 · nickd@i-nett.com' },
      disclaimer: METHODOLOGY_NOTE + ' This report is for general information only and is meant to be reviewed together with the i-NETT team. It is not a formal audit or assessment, and not legal, compliance, security, or insurance advice. Scores and estimates are illustrative and industry-informed; any frameworks named may or may not apply to your organization.',
      recoverable: r.rec.weeklyHigh > 0 ? {
        heroText: 'Up to ' + usd(r.rec.annualHigh) + ' / year',
        subText: r.rec.weeklyLow + '–' + r.rec.weeklyHigh + ' hrs/wk · $' + r.rec.rate + '/hr fully loaded · conservative estimate',
        items: r.rec.byTask.filter((t) => t.high > 0).map((t) => ({ label: t.label, hrs: 'up to ' + t.high + ' hrs/wk' })),
      } : undefined,
    };
  }

  // Client view: 3 generic findings in full + everything else as a locked
  // category/priority/confidence row — no detail, per the IP-protection design.
  function buildClientReportData(lead: any, r: Report, note: string, opts: ReportOpts): ReportData {
    const d = baseReportData(lead, r, note);
    d.findings = opts.findings.map((f, i) => toReportFinding(f, i));
    d.lockedAreas = [...opts.teasers, ...opts.locked].map((f) => ({
      area: f.tag, assessment: riskLabel(f.sev), priority: f.sev === 'danger' ? 'high' as const : 'normal' as const, confidence: riskScore(f),
    }));
    return d;
  }

  // Internal view: every finding gets a full card, nothing locked.
  function buildInternalReportData(lead: any, r: Report, note: string): { data: ReportData; findings: ReportFinding[] } {
    const d = baseReportData(lead, r, note);
    const findings = r.findings.map((f, i) => toReportFinding(f, i));
    d.findings = findings.slice(0, 3);
    return { data: d, findings };
  }


  // Capture the lead into HubSpot FROM THE BROWSER — not via the Worker.
  // Server-side Forms API submissions (the Worker, curl) return 200 but HubSpot
  // silently drops them as bot traffic, so scan leads were never becoming
  // contacts. A browser submission, with the hubspotutk tracking cookie for
  // context, lands reliably (verified 2026-08-18). Best-effort: never blocks
  // the report the visitor already has.
  const HS_PORTAL = '39725947';
  const HS_FORM_GUID = '75738be2-d147-4aac-8eb0-0250a37c46a6';
  function cookie(name: string): string {
    const m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
    return m ? decodeURIComponent(m.pop() as string) : '';
  }
  async function hubspotCapture(lead: any, r: Report, reportUrl: string) {
    const parts = String(lead.name || '').trim().split(/\s+/);
    const preferred = Array.isArray(lead.contact) ? lead.contact.join(', ') : (lead.contact || '');
    const message = `Fortify AI Readiness Scan — exposure ${r.score}/100 (${r.band}). `
      + `Shadow AI: ${r.shadowLevel}. Compliance flags: ${(r.flags || []).join('; ') || 'none'}. `
      + (preferred ? `Preferred contact: ${preferred}. ` : '') + `Report: ${reportUrl}`;
    const fields = [
      { name: 'email', value: lead.email || '' },
      { name: 'firstname', value: parts.shift() || '' },
      { name: 'lastname', value: parts.join(' ') },
      { name: 'company', value: lead.company || '' },
      { name: 'phone', value: lead.cell || '' },
      { name: 'website', value: lead.website || '' },
      { name: 'message', value: message },
    ].filter((f) => f.value !== '');
    const hutk = cookie('hubspotutk');
    try {
      await fetch(`https://api.hsforms.com/submissions/v3/integration/submit/${HS_PORTAL}/${HS_FORM_GUID}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fields,
          context: { ...(hutk ? { hutk } : {}), pageUri: location.href, pageName: 'AI Readiness Scan' },
        }),
      });
    } catch (e) { /* best-effort */ }
  }

  async function submitLead(lead: any) {
    const r = currentReport as Report;
    const note = aiNote || r.fallbackNote;
    const clientOpts: ReportOpts = genericView(r.findings);
    const clientData = buildClientReportData(lead, r, note, clientOpts);
    const reportUrl = location.origin + '/report#r=' + encodeReport(clientData);

    // Fire the browser-side HubSpot capture immediately — this is what actually
    // creates the contact. The Worker call below still runs for email + PDF.
    hubspotCapture(lead, r, reportUrl);

    // Two logo treatments, because the two render paths have different needs.
    // The Worker's headless Chromium fetches https:// assets normally, so it
    // gets small absolute URLs. The in-browser raster path can't: a same-site
    // absolute URL still reads as cross-origin from the detached capture
    // iframe and taints the canvas, so it needs the bytes inlined.
    const remoteOpts = {
      glow: false,
      logoFortify: location.origin + '/assets/brand/fortify-ai-logo.png',
      logoInett: location.origin + '/assets/brand/inett-logo.png',
    };

    const { data: internalData, findings: allFindings } = buildInternalReportData(lead, r, note);

    // Server-rendered path (preferred): post the report HTML and let the Worker
    // turn it into a real vector PDF. Cheap to build — it's just strings.
    let htmlFull: string | null = null;
    let htmlClient: string | null = null;
    try {
      htmlFull = reportDocument(await buildInternalReportPages(internalData, allFindings, remoteOpts));
      htmlClient = reportDocument(renderReport(clientData, remoteOpts));
    } catch (e) { htmlFull = null; htmlClient = null; }

    // Client-side raster fallback, now OFF: server-side rendering is confirmed
    // working in production (2026-08-17 — 1.5-3.3s per render, and the one
    // rate-limited attempt recovered on retry). Leaving it on made every
    // visitor's browser spend ~30s producing a bitmap the Worker then threw
    // away. Flip back to true only if Browser Rendering is unavailable.
    const RASTER_FALLBACK = false;
    let pdfFull: string | null = null;
    let pdfClient: string | null = null;
    if (RASTER_FALLBACK) {
      const [logoFortifyUri, logoInettUri] = await Promise.all([
        imageToDataUri(location.origin + '/assets/brand/fortify-ai-logo.png'),
        imageToDataUri(location.origin + '/assets/brand/inett-logo.png'),
      ]);
      const captureOpts = { glow: false, logoFortify: logoFortifyUri, logoInett: logoInettUri };
      try {
        const html = await buildInternalReportPages(internalData, allFindings, captureOpts);
        pdfFull = (await htmlPagesToPdf(html)).base64;
      } catch (e) { pdfFull = null; }
      try {
        pdfClient = (await htmlPagesToPdf(renderReport(clientData, captureOpts))).base64;
      } catch (e) { pdfClient = null; }
    }

    fetch(PROXY_URL + '/lead', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        lead, answers,
        computed: {
          score: r.score, band: r.band, shadowLevel: r.shadowLevel, flags: r.flags, hours: r.hoursVal,
          findings: r.findings.map((f) => ({ tag: f.tag, headline: f.head, detail: f.detail, fix: f.fix, sev: f.sev, prev: f.prev })),
        },
        analystNote: note,
        reportUrl,
        htmlFull,
        htmlClient,
        pdfFull,
        pdfClient,
        pageUrl: location.href,
      }),
    }).catch(() => { /* best-effort; the visitor already has their report */ });
  }

  // findings = shown in full; teasers = unused (kept for type compat, always empty);
  // locked = redacted — category + risk score only, no headline, no detail.
  type ReportOpts = { findings: Finding[]; teasers: Finding[]; locked: Finding[] };

  // The CLIENT view: reveal the FULL_FINDINGS most GENERIC findings in full,
  // and redact every remaining (higher-value) finding — category + risk score
  // only, no headline. Book a session to have those walked through.
  function genericView(all: Finding[]): ReportOpts {
    const g = [...all].sort((a, b) => (b.gen || 0) - (a.gen || 0));
    return { findings: g.slice(0, FULL_FINDINGS), teasers: [], locked: g.slice(FULL_FINDINGS) };
  }
  function riskLabel(sev: string): string {
    return sev === 'danger' ? 'High priority' : sev === 'warn' ? 'Elevated' : 'Worth reviewing';
  }
  // Illustrative per-finding risk score (0-100). Higher = more worth addressing.
  // Deterministic from severity + the finding's weight; capped so it stays sane.
  function riskScore(f: Finding): number {
    const base = f.sev === 'danger' ? 68 : f.sev === 'warn' ? 46 : 32;
    const w = f.w || (f.sev === 'danger' ? 18 : f.sev === 'warn' ? 12 : 8);
    const cap = f.sev === 'danger' ? 22 : f.sev === 'warn' ? 20 : 16;
    return Math.max(28, Math.min(90, base + Math.min(cap, Math.round(w))));
  }

  function answerRows(): { label: string; value: string }[] {
    // Map task ids -> readable labels for the scan-inputs appendix.
    const taskLabels: Record<string, string> = {};
    tasksForIndustry(answers.industry || 'Other').forEach((t) => { taskLabels[t.id] = t.label; });
    return QUESTIONS.map((q) => {
      const v = answers[q.id];
      if (q.id === 'tasks') {
        const ids: string[] = Array.isArray(v) ? v : [];
        return { label: 'Tasks still done by hand', value: ids.length ? ids.map((id) => taskLabels[id] || id).join(', ') : '(none selected)' };
      }
      if (q.id === 'headcount') {
        const hc = v && typeof v === 'object' ? v : {};
        const parts = Object.keys(hc).map((area) => (AREA_LABEL[area as TaskArea] || area) + ': ' + hc[area]);
        return { label: 'People doing that work', value: parts.length ? parts.join(' · ') : '(not specified)' };
      }
      return { label: q.label, value: Array.isArray(v) ? (v.join(', ') || '(skipped)') : (v || '(skipped)') };
    });
  }

</script>
