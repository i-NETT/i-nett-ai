  .scan__statVal { font-size: 13px; font-weight: 700; color: var(--color-ink-800); }
  .scan__statSub { font-size: 11px; color: var(--color-text-soft); margin-top: 2px; line-height: 1.5; }

  .scan__findingsLabel { font-family: var(--font-mono); font-size: 9px; color: var(--color-text-muted); letter-spacing: 2px; margin-bottom: 10px; }
  .scan__finding { border-radius: var(--radius-md); padding: var(--space-5); margin-bottom: var(--space-4); border: 1px solid var(--color-border); border-left-width: 4px; background: var(--color-bg-soft); box-shadow: var(--shadow-sm); }
  .scan__finding--warn { border-left-color: var(--color-warning); }
  .scan__finding--danger { border-left-color: var(--color-danger); }
  .scan__finding--info { border-left-color: var(--color-accent-500); }
  .scan__findingTop { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); margin-bottom: 10px; }
  .scan__findingNum { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--color-text-muted); white-space: nowrap; }
  .scan__findingHead { font-weight: 700; font-size: var(--fs-md); line-height: 1.35; margin-bottom: 8px; color: var(--color-ink-800); }
  .scan__findingDetail { color: var(--color-text-soft); font-size: var(--fs-sm); line-height: 1.65; margin-bottom: 12px; max-width: none; }
  .scan__findingFix { font-size: var(--fs-sm); line-height: 1.6; color: var(--color-text); background: var(--color-bg-soft); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 11px 13px; }
  .scan__findingFix strong { color: var(--color-success); font-weight: 700; }

  /* "How common" — three prevalence bars, one per segment, distinct colors */
  .scan__prev { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
  .scan__prevLead { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1.5px; color: var(--color-text-muted); text-transform: uppercase; margin-bottom: 12px; }
  .scan__prevRow { display: grid; grid-template-columns: 132px 1fr 46px; align-items: center; gap: 12px; margin-bottom: 9px; }
  .scan__prevLabel { font-size: 12px; color: var(--color-text-soft); }
  .scan__prevBar { height: 9px; background: var(--color-bg-muted); border-radius: 999px; overflow: hidden; }
  .scan__prevFill { display: block; height: 100%; border-radius: 999px; transition: width 0.6s var(--ease-out); }
  /* Sequential brand ramp (light cyan -> deep navy) — one hue family, distinct per row */
  .scan__prevFill--sm { background: var(--color-accent-300); }
