  .scan__statLabel { font-family: var(--font-mono); font-size: 9px; letter-spacing: 2px; margin-bottom: 3px; }
  .scan__stat--warn .scan__statLabel { color: var(--color-warning); }
  .scan__stat--danger .scan__statLabel { color: var(--color-danger); }
