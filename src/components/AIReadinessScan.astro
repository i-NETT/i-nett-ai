  @media (max-width: 480px) { .scan__prevRow { grid-template-columns: 92px 1fr 42px; gap: 8px; } }

  .scan__locked { background: var(--color-bg-soft); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 13px 14px; margin-bottom: 8px; position: relative; overflow: hidden; }
  .scan__lockedGhost { opacity: 0.18; }
  .scan__ghostBar { height: 7px; background: var(--color-border-strong); border-radius: 4px; margin-bottom: 6px; }
  .scan__lockedOverlay { position: absolute; inset: 0; background: rgba(246,248,251,0.82); display: flex; align-items: center; justify-content: center; gap: 8px; }
  .scan__lockLabel { font-family: var(--font-mono); font-size: 10px; color: var(--color-text-muted); letter-spacing: 1px; }

  /* "Rest of your report" boxes — redacted findings beyond the 3 shown in
     full. Rendered at the SAME full size as a shown finding on purpose:
     shrinking them down would read as if something was being hidden rather
     than deliberately protected. Background goes dark (near the site's own
     dark sections) to visually read as "locked," distinct from the shown
     findings' light cards. A bright light-beam traces the border to signal
     "open me," not "closed off." */
  @property --scan-beam-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  .scan__teaser {
    position: relative; border: 1px solid rgba(255,255,255,0.14); border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5); margin-bottom: var(--space-3);
    background: var(--color-ink-900);
  }
  .scan__teaser::before {
    content: ''; position: absolute; inset: -1.5px; border-radius: inherit; padding: 2.5px;
    background: conic-gradient(from var(--scan-beam-angle), transparent 0%, transparent 68%, var(--color-accent-400) 82%, var(--color-glow) 90%, var(--color-accent-400) 96%, transparent 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    animation: scan-beam-rotate 4s linear infinite; pointer-events: none;
    filter: drop-shadow(0 0 6px rgba(0,224,255,0.55));
  }
  @keyframes scan-beam-rotate { to { --scan-beam-angle: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .scan__teaser::before, .scan__meeting::before { animation: none; } }
  .scan__teaserFoot { font-size: 12px; color: var(--color-text-on-dark-soft); line-height: 1.55; }

  /* Score badge: red/amber/green read on the finding — signals good vs. bad
     news without revealing what the finding is. */
  .scan__scoreBadge { font-family: var(--font-mono); font-size: 13px; font-weight: 700; white-space: nowrap; padding: 2px 8px; border-radius: var(--radius-pill); border: 1px solid; }
  .scan__scoreBadge--high { color: #FF7A6B; border-color: #FF7A6B; background: rgba(255,122,107,0.12); }
  .scan__scoreBadge--mid { color: #FFC46B; border-color: #FFC46B; background: rgba(255,196,107,0.12); }
  .scan__scoreBadge--low { color: #7BE0A8; border-color: #7BE0A8; background: rgba(123,224,168,0.12); }

  /* Redacted findings: same box, ghost bars stand in for the withheld
     headline/detail so the box reads as substantial, not empty. */
  .scan__redactedBar { height: 11px; border-radius: 4px; margin: 4px 0; background: linear-gradient(90deg, rgba(255,255,255,0.22) 0%, rgba(255,255,255,0.09) 50%, rgba(255,255,255,0.22) 100%); }
  .scan__redactedBar--short { width: 62%; margin-bottom: 10px; }

  /* Meeting gate — the rest is a working session. Same beam treatment as the
     redacted cards, but bigger: this is the single most important box on the
     screen, so it should read as the brightest. */
  .scan__meeting {
    position: relative; background: var(--color-ink-900); color: var(--color-text-on-dark);
    border-radius: var(--radius-lg); padding: var(--space-6); margin: var(--space-4) 0 var(--space-5); text-align: center;
    box-shadow: 0 0 60px -10px rgba(0,224,255,0.35);
