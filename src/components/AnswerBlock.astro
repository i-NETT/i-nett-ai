---
// Answer-first block. Renders a direct, quotable answer above marketing copy.
// The .answer-block__a element is the Speakable schema target (pass its
// selector via the page's `speakable` prop).
interface Props {
  question?: string;
  label?: string;
  class?: string;
}
const { question, label = 'Short answer', class: className } = Astro.props;
---
<div class:list={['answer-block', className]}>
  <p class="answer-block__label">{label}</p>
  {question && <p class="answer-block__q">{question}</p>}
  <div class="answer-block__a">
    <slot />
  </div>
</div>

<style>
  .answer-block {
    margin: 0 0 var(--space-6);
    padding: var(--space-5) var(--space-6);
    border-left: 4px solid var(--color-accent-500);
    background: var(--color-bg-soft);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .answer-block__label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-accent-500);
    margin-bottom: var(--space-2);
  }
  .answer-block__q {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }
  .answer-block__a {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-text);
  }
  .answer-block__a :global(p) { margin-bottom: var(--space-3); }
  .answer-block__a :global(p:last-child) { margin-bottom: 0; }
</style>
