---
import { SITE, NAV_PRIMARY } from '@lib/site';
const path = Astro.url.pathname;
---
<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name} by ${SITE.parent}, home`}>
      <img
        src="/assets/brand/fortify-ai-logo-mark.png"
        alt=""
        class="brand__mark"
        width="36"
        height="36"
        loading="eager"
        decoding="sync"
      />
      <span class="brand__words">
        <span class="brand__parent">i-NETT</span>
        <span class="brand__product">Fortify AI</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {NAV_PRIMARY.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ 'is-active': path === item.href || path.startsWith(item.href + '/') }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__cta">
      <a href={SITE.bookingUrl} class="btn btn-accent" target="_blank" rel="noopener">
        Book a consultation
      </a>
    </div>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav aria-label="Mobile">
      <ul>
        {NAV_PRIMARY.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/contact">Contact</a></li>
      </ul>
      <a href={SITE.bookingUrl} class="btn btn-accent btn-block" target="_blank" rel="noopener">
        Book a 30 minute consultation
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--color-border);
    padding-top: env(safe-area-inset-top);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink-800);
    flex-shrink: 0;
  }
  .brand:hover { color: var(--color-ink-800); }
  .brand__mark {
    width: 36px;
    height: 36px;
    object-fit: contain;
    display: block;
    transition: transform var(--dur-base) var(--ease-out), filter var(--dur-base) var(--ease-out);
  }
  .brand:hover .brand__mark {
    transform: scale(1.05);
    filter: drop-shadow(0 0 8px rgba(0, 224, 255, 0.45));
  }
  .brand__words { display: inline-flex; flex-direction: column; line-height: 1.1; }
  .brand__parent {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }
  .brand__product {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--color-ink-800);
  }

  .site-nav { display: none; flex: 1; justify-content: center; }
  .site-nav ul { display: flex; gap: var(--space-5); list-style: none; padding: 0; margin: 0; }
  .site-nav a {
    color: var(--color-text);
    font-size: var(--fs-sm);
    font-weight: 500;
    padding: 0.5em 0;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .site-nav a:hover { color: var(--color-accent-500); }
  .site-nav a.is-active { color: var(--color-ink-800); border-bottom-color: var(--color-accent-500); }

  .site-header__cta { display: none; }

  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    align-items: center;
    border-radius: var(--radius-md);
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink-800);
    border-radius: 2px;
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-nav {
    padding: var(--space-4) var(--gutter) var(--space-6);
    background: #fff;
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-nav ul { list-style: none; padding: 0; margin: 0 0 var(--space-4); }
  .mobile-nav li { border-bottom: 1px solid var(--color-border); }
  .mobile-nav a {
    display: block;
    padding: var(--space-4) 0;
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--color-text);
  }

  @media (min-width: 960px) {
    .site-nav { display: flex; }
    .site-header__cta { display: flex; }
    .nav-toggle { display: none; }
    .mobile-nav { display: none !important; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      mobileNav.hidden = open;
    });
  }
</script>
