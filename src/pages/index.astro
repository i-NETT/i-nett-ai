---
import BaseLayout from '@layouts/BaseLayout.astro';
import ROIModal from '@components/ROIModal.astro';
import FAQ from '@components/FAQ.astro';
import CTASection from '@components/CTASection.astro';
import { SITE } from '@lib/site';

const faqs = [
  {
    q: 'What is Fortify AI?',
    a: 'Fortify AI is a managed AI offering from i-NETT. We deploy secure, compliance-ready AI infrastructure into your firm, configure it to your regulatory environment, and operate it for you. Customer data is isolated to a dedicated tenant. We do not use customer data for model training or share it across clients.'
  },
  {
    q: 'How is Fortify AI different from buying ChatGPT or Copilot licenses?',
    a: 'Consumer and prosumer AI tools were built for individuals. Fortify AI is built for firms that operate under HIPAA, GDPR, SOC, or CCPA. Each deployment is configured to your regulatory environment, isolated to your tenant, and reviewed by your compliance team. It is the difference between a personal productivity tool and a managed business system.'
  },
  {
    q: 'Who is Fortify AI built for?',
    a: 'Mid-market firms with 30 to 150 employees in healthcare, legal, financial services, and professional services. Our buyers are CEOs and owners who want AI capability without building an in-house data science team.'
  },
  {
    q: 'What does deployment look like?',
    a: 'A typical Fortify AI deployment runs in four stages: a 30 minute consultation to scope your environment, a readiness assessment, a focused two to four week pilot on the highest-leverage use cases, then a managed rollout. Your team works with our deployment lead throughout. We handle the infrastructure.'
  },
  {
    q: 'Is Fortify AI HIPAA compliant?',
    a: 'Fortify AI deployments are built for HIPAA, GDPR, SOC, and CCPA compliance. Deployments are configured to your regulatory environment and reviewed by your compliance team. Underwritten by Lloyd’s of London cybersecurity insurance policy.'
  },
  {
    q: 'What geographies does i-NETT cover?',
    a: 'i-NETT is headquartered in Southern California with primary client community across San Diego, Orange County, Los Angeles, and Ventura counties. Through the Technology Assurance Group network, we extend service into 148 cities across the United States and Canada.'
  },
  {
    q: 'How quickly can we get started?',
    a: 'The first step is a 30 minute consultation. From signed engagement, most firms see their first production AI workflow live within four to six weeks. Pilot length scales with the number of workflows in scope.'
  }
];
---
<BaseLayout
  title="Fortify AI by i-NETT : Managed AI for mid-market firms"
  description="Managed AI for 30 to 150 employee firms in healthcare, legal, financial services, and professional services. Built for HIPAA, GDPR, SOC, and CCPA. Underwritten by Lloyd’s of London cybersecurity insurance policy. Serving Southern California, the United States, and Canada."
  faqs={faqs}
  service={{
    name: 'Fortify AI Managed AI Deployment',
    description: 'Managed AI deployment for mid-market firms in regulated industries. Configured for HIPAA, GDPR, SOC, and CCPA compliance.',
  }}
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__grid"></div>
      <div class="hero__orb hero__orb--a"></div>
      <div class="hero__orb hero__orb--b"></div>
    </div>
    <div class="container hero__inner">
      <div class="hero__copy reveal">
        <span class="pill pill-accent hero__pill">
          <span class="hero__pulse" aria-hidden="true"></span>
          Underwritten by Lloyd&rsquo;s of London cybersecurity insurance policy
        </span>
        <h1 id="hero-heading" class="hero__title">
          Managed AI, <span class="hero__title-accent">built for the firms</span> regulators trust.
        </h1>
        <p class="hero__lead">
          Fortify AI deploys secure, compliance-ready AI infrastructure into healthcare,
          legal, financial services, and professional services firms across Southern California,
          the United States, and Canada. We operate it. You see results.
        </p>
        <div class="hero__ctas">
          <a href="/resources#scan" class="btn btn-accent btn-lg">
            Take the AI Readiness Scan
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={SITE.bookingUrl} class="btn btn-outline btn-lg" target="_blank" rel="noopener">
            Book a 30 minute consultation
          </a>
        </div>
        <ul class="hero__trust">
          <li>HIPAA, GDPR, SOC, CCPA ready</li>
          <li>Customer data isolated to your tenant</li>
          <li>148 service cities across US and Canada</li>
        </ul>
      </div>

      <aside class="hero__panel reveal" aria-label="Fortify AI capability snapshot">
        <div class="hero-card">
          <div class="hero-card__top">
            <span class="hero-card__label">Live deployment</span>
            <span class="hero-card__dot" aria-hidden="true"></span>
          </div>
          <p class="hero-card__metric">$1.95M</p>
          <p class="hero-card__sub">Estimated annual productivity opportunity, typical 150-employee healthcare practice.</p>
          <div class="hero-card__bars" aria-hidden="true">
            <div style="--h:32%"></div>
            <div style="--h:58%"></div>
            <div style="--h:71%"></div>
            <div style="--h:84%"></div>
            <div style="--h:96%"></div>
          </div>
          <a href="#roi" class="hero-card__link">See your firm&rsquo;s number &rarr;</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- LOGO ROW / SOCIAL PROOF -->
  <section class="proof-bar">
    <div class="container">
      <p class="proof-bar__title">Trusted by mid-market firms across the regulated industries</p>
      <div class="proof-bar__items">
        <div class="proof-pill">
          <img src="/assets/brand/hipaa-compliant.png" alt="HIPAA Compliant badge" width="36" height="36" loading="lazy" />
          <span>HIPAA Compliant</span>
        </div>
        <div class="proof-pill">
          <img src="/assets/brand/iso-27001.png" alt="ISO 27001 badge" width="36" height="36" loading="lazy" />
          <span>ISO 27001 aligned</span>
        </div>
        <div class="proof-pill">
          <img src="/assets/brand/chamber-ambassador-2025.png" alt="Chamber Ambassador 2025 badge" width="36" height="36" loading="lazy" />
          <span>Chamber Ambassador 2025</span>
        </div>
        <div class="proof-pill proof-pill--text">
          <span class="proof-pill__lead">Lloyd&rsquo;s of London</span>
          <span>Cybersecurity insurance policy</span>
        </div>
        <div class="proof-pill proof-pill--text">
          <span class="proof-pill__lead">TAG Network</span>
          <span>148 service cities, US &amp; Canada</span>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section" id="what-we-do" aria-labelledby="what-we-do-heading">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">What we do</span>
        <h2 id="what-we-do-heading">Three things, done at the standard your industry actually requires.</h2>
        <p class="lead">
          Fortify AI is not an AI strategy deck. It is the infrastructure, the deployment, and
          the operating team that ships AI into your firm in weeks, not quarters.
        </p>
      </div>
      <div class="grid grid-3">
        <article class="card reveal">
          <span class="card-num">01</span>
          <h3>Compliance-first infrastructure</h3>
          <p>
            Each Fortify AI deployment is configured to your regulatory environment.
            Customer data is isolated to your dedicated tenant. We do not use customer
            data for model training or share it across clients.
          </p>
        </article>
        <article class="card reveal">
          <span class="card-num">02</span>
          <h3>Targeted, high-leverage workflows</h3>
          <p>
            We identify the two or three workflows where AI returns the most value to
            your firm in the first 90 days. Documentation, intake, summarization,
            knowledge retrieval, client communication. We ship those first.
          </p>
        </article>
        <article class="card reveal">
          <span class="card-num">03</span>
          <h3>Managed operations</h3>
          <p>
            i-NETT operates the deployment. Monitoring, updates, model evaluation,
            policy enforcement, and quarterly compliance review are included. Your
            team uses the system. We run it.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section section-dark" id="why-us" aria-labelledby="why-us-heading">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">Why Fortify AI</span>
        <h2 id="why-us-heading">Three things consumer AI cannot give you.</h2>
      </div>
      <div class="grid grid-3">
        <div class="card card-dark reveal">
          <h3>An underwritten security posture</h3>
          <p>
            Fortify AI deployments are operated inside an environment underwritten by
            Lloyd&rsquo;s of London cybersecurity insurance policy. That is not marketing
            language. It is a financial backstop.
          </p>
        </div>
        <div class="card card-dark reveal">
          <h3>A regulatory blueprint, not a checkbox</h3>
          <p>
            HIPAA, GDPR, SOC, and CCPA are designed into deployment from day one,
            then reviewed by your compliance team. You get a configuration you can
            defend, not a vendor questionnaire you have to chase.
          </p>
        </div>
        <div class="card card-dark reveal">
          <h3>A managed services team behind the model</h3>
          <p>
            AI without operations is a liability. We bring 20 plus years of managed
            services discipline into every Fortify AI rollout, including 24/7 monitoring
            through the Technology Assurance Group network.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section how-section" id="how-it-works" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">How it works</span>
        <h2 id="how-heading">From first conversation to live deployment in four to six weeks.</h2>
      </div>
      <ol class="how-steps">
        <li class="how-step reveal">
          <span class="how-step__num">1</span>
          <div>
            <h3>30 minute consultation</h3>
            <p>
              We scope your environment, your compliance footprint, and the two or
              three highest-leverage AI deployments for your firm.
            </p>
          </div>
        </li>
        <li class="how-step reveal">
          <span class="how-step__num">2</span>
          <div>
            <h3>Readiness assessment</h3>
            <p>
              We map your data sources, your existing systems, and the regulatory
              constraints that will shape the configuration. You receive a written
              readiness scan.
            </p>
          </div>
        </li>
        <li class="how-step reveal">
          <span class="how-step__num">3</span>
          <div>
            <h3>Pilot in two to four weeks</h3>
            <p>
              We deploy a focused pilot on the highest-leverage workflow. Your team
              uses it. We measure results. Your compliance team reviews.
            </p>
          </div>
        </li>
        <li class="how-step reveal">
          <span class="how-step__num">4</span>
          <div>
            <h3>Managed rollout</h3>
            <p>
              We expand to your full team and additional workflows. i-NETT operates
              the deployment, with quarterly compliance review and continuous model
              evaluation built in.
            </p>
          </div>
        </li>
      </ol>
      <div class="how-cta reveal">
        <a href="/how-it-works" class="btn btn-outline">Read the full methodology &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ROI CALCULATOR TRIGGER -->
  <section class="section section-roi" id="roi" aria-labelledby="roi-heading">
    <div class="container container-narrow reveal">
      <span class="eyebrow">Your number</span>
      <h2 id="roi-heading">What is a five-hour-per-week productivity uplift worth to your firm?</h2>
      <p class="lead">
        Pick your industry. Drag the sliders. The number is yours to take to your board.
      </p>
      <div class="roi-trigger-wrap">
        <ROIModal />
        <a href="/roi-calculator" class="btn btn-ghost">Or open the full calculator page &rarr;</a>
      </div>
    </div>
  </section>

  <!-- PROOF / PEOPLE -->
  <section class="section section-soft" aria-labelledby="people-heading">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">Built by operators</span>
        <h2 id="people-heading">The team behind Fortify AI.</h2>
      </div>
      <div class="grid grid-2 people-grid">
        <article class="person-card reveal">
          <img src="/assets/brand/nick-headshot.jpg" alt="Nick Dreyfus, VP of Business Development at i-NETT" width="120" height="120" loading="lazy" />
          <div>
            <h3>Nick Dreyfus</h3>
            <p class="person-card__role">VP of Business Development, i-NETT</p>
            <p>
              Host of The Digital Dilemma podcast. Chamber Ambassador of the Year 2025.
              Twenty years working with mid-market CEOs on the operational realities of
              technology, compliance, and growth.
            </p>
          </div>
        </article>
        <article class="person-card reveal">
          <img src="/assets/brand/dale-stein-headshot.jpg" alt="Dale Stein, co-founder of Technology Assurance Group" width="120" height="120" loading="lazy" />
          <div>
            <h3>Dale Stein</h3>
            <p class="person-card__role">Co-founder, Technology Assurance Group (TAG)</p>
            <p>
              TAG is the national managed services network behind i-NETT&rsquo;s coverage
              footprint across 148 cities in the United States and Canada. ISO 27001
              aligned. Built for the firms regulators trust.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section" aria-labelledby="industries-heading">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">Industries</span>
        <h2 id="industries-heading">Built for regulated, relationship-driven firms.</h2>
      </div>
      <div class="grid grid-4">
        <a href="/industries/healthcare" class="card reveal industry-card">
          <h3>Healthcare</h3>
          <p>HIPAA-aligned AI for practices and provider groups.</p>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/industries/legal" class="card reveal industry-card">
          <h3>Legal</h3>
          <p>Privileged-information-safe AI for law firms.</p>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/industries/financial-services" class="card reveal industry-card">
          <h3>Financial Services</h3>
          <p>Regulator-ready AI for advisors and firms.</p>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/industries/professional-services" class="card reveal industry-card">
          <h3>Professional Services</h3>
          <p>Confidentiality-first AI for consulting and accounting.</p>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PODCAST -->
  <section class="section section-soft" aria-labelledby="podcast-heading">
    <div class="container">
      <div class="podcast-promo reveal">
        <div>
          <span class="eyebrow">From the podcast</span>
          <h2 id="podcast-heading">The Digital Dilemma</h2>
          <p class="lead">
            Nick Dreyfus interviews founders, technologists, and CEOs on the operational
            realities of running a modern business. AI, cybersecurity, and what actually
            ships.
          </p>
          <div class="podcast-promo__ctas">
            <a href={SITE.podcastUrl} class="btn btn-primary" target="_blank" rel="noopener">
              Listen on Apple Podcasts
            </a>
            <a href="/podcast" class="btn btn-outline">All episodes</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTASection
    heading="Ready to evaluate Fortify AI for your firm?"
    body="Book a 30 minute consultation. We will scope your environment, identify the highest-leverage AI deployments for your team, and outline what a Fortify AI rollout looks like."
  />
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    background: var(--color-ink-900);
    color: var(--color-text-on-dark);
    padding: clamp(3.5rem, 6vw + 1rem, 7rem) 0 clamp(3.5rem, 6vw + 1rem, 6rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .hero__grid {
    position: absolute;
    inset: -1px;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 30% 40%, #000 40%, transparent 80%);
  }
  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.45;
  }
  .hero__orb--a {
    width: 520px; height: 520px;
    background: radial-gradient(circle, #00B4FF 0%, transparent 70%);
    top: -120px; left: -120px;
  }
  .hero__orb--b {
    width: 600px; height: 600px;
    background: radial-gradient(circle, #11355C 0%, transparent 70%);
    bottom: -200px; right: -150px;
    opacity: 0.6;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__inner { grid-template-columns: 1.3fr 1fr; gap: var(--space-9); }
  }

  .hero__pill {
    margin-bottom: var(--space-5);
    background: rgba(0,180,255,0.12);
    border-color: rgba(0,180,255,0.35);
    color: var(--color-text-on-dark);
  }
  .hero__pulse {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--color-glow);
    box-shadow: 0 0 0 0 rgba(0,224,255,0.7);
    animation: pulse 2.4s ease-out infinite;
    display: inline-block;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(0,224,255,0.6); }
    70% { box-shadow: 0 0 0 14px rgba(0,224,255,0); }
    100% { box-shadow: 0 0 0 0 rgba(0,224,255,0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__pulse { animation: none; }
  }

  .hero__title {
    font-size: var(--fs-hero);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: #fff;
    margin-bottom: var(--space-5);
  }
  .hero__title-accent {
    background: linear-gradient(135deg, #00E0FF 0%, #00B4FF 60%, #66D6FF 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero__lead {
    font-size: var(--fs-md);
    color: var(--color-text-on-dark-soft);
    max-width: 56ch;
    margin-bottom: var(--space-6);
  }
  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 480px) {
    .hero__ctas { flex-direction: row; }
  }
  .hero__trust {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-on-dark-soft);
    font-size: var(--fs-sm);
  }
  .hero__trust li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .hero__trust li::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--color-glow);
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .hero__trust { grid-template-columns: repeat(3, 1fr); }
  }

  /* Hero card */
  .hero__panel { position: relative; }
  .hero-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }
  .hero-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
  }
  .hero-card__label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-glow);
    font-weight: 600;
  }
  .hero-card__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--color-glow);
    box-shadow: 0 0 12px var(--color-glow);
  }
  .hero-card__metric {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.75rem, 1.5rem + 5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fff;
    background: linear-gradient(180deg, #fff 0%, #B7C6D8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-card__sub {
    color: var(--color-text-on-dark-soft);
    font-size: var(--fs-sm);
    margin-top: var(--space-3);
    line-height: var(--lh-normal);
  }
  .hero-card__bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 64px;
    margin: var(--space-5) 0;
  }
  .hero-card__bars div {
    flex: 1;
    height: var(--h);
    background: linear-gradient(180deg, var(--color-glow) 0%, var(--color-accent-500) 100%);
    border-radius: 4px 4px 0 0;
    opacity: 0.85;
  }
  .hero-card__link {
    display: inline-block;
    color: var(--color-glow);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .hero-card__link:hover { color: #fff; }

  /* PROOF BAR */
  .proof-bar {
    padding: var(--space-7) 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .proof-bar__title {
    text-align: center;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
    font-weight: 600;
  }
  .proof-bar__items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    align-items: stretch;
  }
  .proof-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    color: var(--color-ink-700);
    font-weight: 500;
  }
  .proof-pill img {
    width: 36px; height: 36px;
    object-fit: contain;
  }
  .proof-pill--text { flex-direction: column; align-items: flex-start; gap: 2px; }
  .proof-pill__lead {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink-800);
    font-size: var(--fs-sm);
  }

  /* SECTION INTROS */
  .section-intro {
    max-width: 64ch;
    margin: 0 auto var(--space-8);
    text-align: center;
  }
  .section-intro .lead {
    margin-left: auto;
    margin-right: auto;
    margin-top: var(--space-4);
  }

  /* CARD numbers */
  .card-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-accent-500);
    font-weight: 600;
    margin-bottom: var(--space-3);
    letter-spacing: 0.1em;
  }
  .section-dark .card-num { color: var(--color-glow); }
  .card h3 { margin-bottom: var(--space-3); }

  /* HOW STEPS */
  .how-steps {
    list-style: none;
    padding: 0;
    margin: 0;
