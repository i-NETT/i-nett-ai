  .hero__tagline-word:nth-child(4) { animation-delay: 1000ms; }
  .hero__tagline-word:nth-child(5) { animation-delay: 1100ms; }
  .hero__tagline-word:nth-child(6) { animation-delay: 1200ms; }
  .hero__tagline-word:nth-child(7) { animation-delay: 1450ms; }
  .hero__tagline-word--accent {
    background: linear-gradient(135deg, #00E0FF 0%, #00B4FF 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  @keyframes tagline-word {
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__tagline-word { opacity: 1; transform: none; animation: none; }
  }
  .hero__lead {
    font-size: var(--fs-md);
    color: var(--color-text-on-dark-soft);
    max-width: 56ch;
    margin-bottom: var(--space-6);
  }
  .hero__offers {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .hero__offers { grid-template-columns: 1fr 1fr; } }
  .hero__offer {
    display: block;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.04);
    color: var(--color-text-on-dark);
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }
  .hero__offer:hover { border-color: var(--color-accent-500); background: rgba(0,180,255,0.08); }
  .hero__offer-tag {
    display: block;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-accent-400);
    margin-bottom: var(--space-1);
  }
  .hero__offer-title { display: block; font-weight: 600; font-size: var(--fs-sm); }
  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 480px) {
    .hero__ctas { flex-direction: row; }
  }
  .hero__trust {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-on-dark-soft);
    font-size: var(--fs-sm);
  }
  .hero__trust li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .hero__trust li::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--color-glow);
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .hero__trust { grid-template-columns: repeat(3, 1fr); }
  }

  /* Hero logo lockup */
  .hero__panel {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 320px;
  }
  .hero-logo {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .hero-logo__img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: auto;
    max-width: 480px;
    object-fit: contain;
    opacity: 0;
    transform: scale(0.92);
    animation: hero-logo-in 1100ms var(--ease-out) 200ms forwards;
    filter: drop-shadow(0 30px 60px rgba(0, 180, 255, 0.18));
  }
  .hero-logo__halo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(circle at 50% 50%, rgba(0, 224, 255, 0.35) 0%, rgba(0, 180, 255, 0.16) 30%, transparent 65%);
    opacity: 0;
    animation: hero-halo-in 1600ms var(--ease-out) 400ms forwards, hero-halo-pulse 6s var(--ease-in-out) 2.4s infinite;
    filter: blur(20px);
  }
  .hero-logo__scan {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(110deg, transparent 38%, rgba(0, 224, 255, 0.42) 50%, transparent 62%);
    mix-blend-mode: screen;
    transform: translateX(-120%);
    animation: hero-scan 1400ms var(--ease-out) 1200ms forwards;
    mask-image: radial-gradient(circle at 50% 50%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 30%, transparent 75%);
  }
  @keyframes hero-logo-in {
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes hero-halo-in {
    to { opacity: 1; }
  }
  @keyframes hero-halo-pulse {
    0%, 100% { transform: scale(1); opacity: 0.85; }
    50% { transform: scale(1.06); opacity: 1; }
  }
  @keyframes hero-scan {
    0% { transform: translateX(-120%); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateX(120%); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-logo__img { opacity: 1; transform: none; animation: none; }
    .hero-logo__halo { opacity: 0.7; animation: none; }
    .hero-logo__scan { display: none; }
  }

  /* PROOF BAR */
  .proof-bar {
    padding: var(--space-7) 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .proof-bar__title {
    text-align: center;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
    font-weight: 600;
  }
  .proof-bar__items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    align-items: stretch;
  }
  .proof-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    color: var(--color-ink-700);
    font-weight: 500;
  }
  .proof-pill img {
    width: 36px; height: 36px;
    object-fit: contain;
  }
  .proof-pill--text { flex-direction: column; align-items: flex-start; gap: 2px; }
  .proof-pill--link {
    text-decoration: none;
    color: var(--color-ink-700);
    transition: border-color 200ms var(--ease-out), background 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .proof-pill--link:hover {
    border-color: var(--color-accent-500);
    background: rgba(0, 180, 255, 0.06);
    transform: translateY(-2px);
    color: var(--color-ink-800);
  }
  .proof-pill--link:hover .proof-pill__lead { color: var(--color-accent-500); }
  .proof-pill__lead {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink-800);
    font-size: var(--fs-sm);
  }

  /* SECTION INTROS */
  .section-intro {
    max-width: 64ch;
    margin: 0 auto var(--space-8);
    text-align: center;
  }
  .section-intro .lead {
    margin-left: auto;
    margin-right: auto;
    margin-top: var(--space-4);
  }

  /* CARD numbers */
  .card-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-accent-500);
    font-weight: 600;
    margin-bottom: var(--space-3);
    letter-spacing: 0.1em;
  }
  .section-dark .card-num { color: var(--color-glow); }
  .card h3 { margin-bottom: var(--space-3); }

  /* HOW STEPS */
  .how-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    counter-reset: step;
  }
  .how-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .how-step:last-child { border-bottom: 0; }
  .how-step__num {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-ink-800);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    display: inline-grid;
    place-items: center;
    font-size: var(--fs-md);
  }
  .how-step h3 { margin-bottom: var(--space-2); }
  .how-cta { text-align: center; margin-top: var(--space-7); }

  /* ROI section: full-width inline calculator */
  .roi-home-intro { max-width: 760px; margin: 0 auto var(--space-7); text-align: center; }
  .roi-home-intro h2 { margin-top: var(--space-2); }
  .roi-home-intro .lead { margin-top: var(--space-4); }
  .roi-home-calc { max-width: 1000px; margin: 0 auto; }
  .section-roi {
    background: linear-gradient(180deg, var(--color-bg-soft) 0%, var(--color-bg) 100%);
  }
  .roi-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  /* Mobile: visual first, copy second */
  .roi-grid__visual { order: -1; }
  @media (min-width: 880px) {
    .roi-grid { grid-template-columns: 6fr 4fr; gap: var(--space-9); }
    .roi-grid__visual { order: 0; }
  }
  .roi-grid__copy h2 { margin-top: var(--space-2); }
  .roi-grid__copy .lead { margin: var(--space-4) 0 var(--space-6); }
  .roi-grid__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: stretch;
  }
  @media (min-width: 480px) {
    .roi-grid__ctas { flex-direction: row; align-items: center; }
  }

  /* Stylized calculator illustration */
  .roi-illustration {
    background: linear-gradient(160deg, var(--color-ink-900) 0%, var(--color-ink-700) 100%);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    color: #fff;
    box-shadow: 0 30px 60px rgba(10, 37, 64, 0.18);
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    max-width: 460px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    isolation: isolate;
  }
  .roi-illustration::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -30%;
    width: 80%;
    height: 80%;
    background: radial-gradient(circle, rgba(0, 224, 255, 0.25) 0%, transparent 70%);
    filter: blur(40px);
    z-index: -1;
  }
  .roi-illustration__chip {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    width: fit-content;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .roi-illustration__chip-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-glow);
    font-weight: 600;
  }
  .roi-illustration__chip-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1;
  }
  .roi-illustration__bars {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 110px;
    margin: var(--space-5) 0;
  }
  .roi-illustration__bars div {
    flex: 1;
    height: var(--h);
    background: linear-gradient(180deg, var(--color-glow) 0%, var(--color-accent-500) 100%);
    border-radius: 6px 6px 0 0;
    opacity: 0.85;
  }
  .roi-illustration__slider {
    margin-top: auto;
  }
  .roi-illustration__track {
    position: relative;
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
  }
  .roi-illustration__fill {
    position: absolute;
    inset: 0 35% 0 0;
    background: linear-gradient(90deg, var(--color-accent-500) 0%, var(--color-glow) 100%);
    border-radius: var(--radius-pill);
  }
  .roi-illustration__thumb {
    position: absolute;
    top: 50%;
    left: 65%;
    transform: translate(-50%, -50%);
    width: 22px;
    height: 22px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(0, 224, 255, 0.35), 0 4px 12px rgba(0, 0, 0, 0.25);
  }
  .roi-illustration__caption {
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  /* Leaders 2x2 grid */
  .leaders-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  @media (min-width: 720px) {
    .leaders-grid { grid-template-columns: 1fr 1fr; gap: var(--space-7); }
  }
  .leader-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform 320ms var(--ease-out), border-color 320ms var(--ease-out), box-shadow 320ms var(--ease-out);
  }
  .leader-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-500);
    box-shadow: 0 20px 40px rgba(10, 37, 64, 0.10);
  }
  .leader-card__photo,
  .leader-card__placeholder {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
    margin-bottom: var(--space-3);
  }
  .leader-card__placeholder {
    display: inline-grid;
    place-items: center;
    background: linear-gradient(135deg, var(--color-ink-800) 0%, var(--color-accent-500) 130%);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    letter-spacing: 0.06em;
    border-color: transparent;
  }
  .leader-card h3 {
    font-size: var(--fs-lg);
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: 4px;
  }
  .leader-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.3em 0.7em;
    background: rgba(0, 180, 255, 0.12);
    color: var(--color-ink-800);
    border: 1px solid rgba(0, 180, 255, 0.3);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .leader-card__role {
    color: var(--color-accent-500);
    font-weight: 600;
    font-size: var(--fs-sm);
    margin-bottom: var(--space-3);
  }
  .leader-card p { color: var(--color-text-soft); font-size: var(--fs-sm); }
  .leader-card__social {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .leader-card__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 0.85em;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-ink-700);
    font-size: var(--fs-xs);
    font-weight: 500;
    transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .leader-card__social a:hover {
    background: rgba(0, 180, 255, 0.08);
    border-color: var(--color-accent-500);
    color: var(--color-ink-800);
  }
  .leader-card__social svg { color: var(--color-ink-700); }
  .leader-card__social a:hover svg { color: var(--color-accent-500); }

  /* Industry cards */
  .industry-card {
    color: var(--color-text);
    position: relative;
    padding-bottom: var(--space-7);
  }
  .industry-card:hover { color: var(--color-text); }
  .industry-card h3 { margin-bottom: var(--space-3); }
  .industry-card .arrow {
    position: absolute;
    bottom: var(--space-5);
    right: var(--space-5);
    color: var(--color-accent-500);
    font-size: 1.25rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .industry-card:hover .arrow { transform: translateX(4px); }

  /* Clickable pillar cards (button reset + reveal-on-hover affordance) */
  .pillar-card {
    text-align: left;
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
    width: 100%;
    background: var(--color-bg);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .pillar-card:focus-visible {
    outline: 2px solid var(--color-accent-500);
    outline-offset: 3px;
  }
  .pillar-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--color-accent-500);
    font-weight: 600;
    font-size: var(--fs-sm);
    margin-top: var(--space-4);
  }
  .pillar-card__arrow {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .pillar-card:hover .pillar-card__arrow {
    transform: translateX(4px);
  }

  /* Pillar detail modal */
  .pillar-modal {
    position: fixed;
    inset: 0;
    z-index: 250;
    display: grid;
    place-items: center;
    padding: var(--space-4);
  }
  .pillar-modal[hidden] { display: none; }
  .pillar-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 11, 20, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: pillar-fade 220ms var(--ease-out);
  }
  .pillar-modal__panel {
    position: relative;
    width: 100%;
    max-width: 760px;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    box-shadow: 0 32px 80px rgba(5, 11, 20, 0.45);
    animation: pillar-in 320ms var(--ease-out);
  }
  .pillar-modal__head {
    position: sticky;
    top: 0;
    background: var(--color-bg);
    z-index: 1;
    padding: var(--space-4) var(--space-5) 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pillar-modal__head .card-num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-accent-500);
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-bottom: 0;
  }
  .pillar-modal__close {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    color: var(--color-ink-800);
    display: inline-grid;
    place-items: center;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .pillar-modal__close:hover { background: var(--color-bg-muted); }
  .pillar-modal__body {
    padding: var(--space-4) var(--space-7) var(--space-7);
  }
  .pillar-modal__icon {
    color: var(--color-accent-500);
    margin-bottom: var(--space-4);
  }
  .pillar-modal__body h2 {
    font-size: var(--fs-2xl);
    margin-bottom: var(--space-4);
  }
  .pillar-modal__body p {
    color: var(--color-text-soft);
    margin-bottom: var(--space-4);
  }
  .pillar-modal__outcomes-head {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-800);
    margin: var(--space-6) 0 var(--space-3);
    font-weight: 600;
  }
  .pillar-modal__outcomes {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: grid;
    gap: var(--space-3);
  }
  .pillar-modal__outcomes li {
    padding: var(--space-3) var(--space-4) var(--space-3) calc(var(--space-4) + 1.5em);
    background: var(--color-bg-soft);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-accent-500);
    position: relative;
    color: var(--color-text);
  }
  .pillar-modal__outcomes li::before {
    content: '';
    position: absolute;
    left: calc(var(--space-4) + 4px);
    top: 1em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent-500);
  }
  .pillar-modal__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-5);
  }
  @keyframes pillar-fade { from { opacity: 0 } to { opacity: 1 } }
  @keyframes pillar-in {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pillar-modal__backdrop, .pillar-modal__panel { animation: none; }
  }

  /* Three Things section */
  .section-three {
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-soft) 100%);
  }
  .three-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
