---
import BaseLayout from '@layouts/BaseLayout.astro';
import ROIModal from '@components/ROIModal.astro';
import ROICalculator from '@components/ROICalculator.astro';
import FAQ from '@components/FAQ.astro';
import CTASection from '@components/CTASection.astro';
import DemoStream from '@components/DemoStream.astro';
import { SITE } from '@lib/site';

const faqs = [
  {
    q: 'What is Fortify AI?',
    a: 'Fortify AI is a managed AI offering from i-NETT. We deploy secure, compliance-ready AI infrastructure into your firm, configure it to your regulatory environment, and operate it for you. Customer data is isolated to a dedicated tenant. We do not use customer data for model training or share it across clients.'
  },
  {
    q: 'How is Fortify AI different from buying ChatGPT or Copilot licenses?',
    a: 'Consumer and prosumer AI tools were built for individuals. Fortify AI is built for firms that operate under HIPAA, GDPR, SOC, or CCPA. Each deployment is configured to your regulatory environment, isolated to your tenant, and reviewed by your compliance team. It is the difference between a personal productivity tool and a managed business system.'
  },
  {
    q: 'Who is Fortify AI built for?',
    a: 'Mid-market firms with 30 to 150 employees in healthcare, legal, financial services, and professional services. Our buyers are CEOs and owners who want AI capability without building an in-house data science team.'
  },
  {
    q: 'What does deployment look like?',
    a: 'A typical Fortify AI deployment runs in four stages: a 30 minute consultation to scope your environment, a readiness assessment, a focused two to four week pilot on the highest-leverage use cases, then a managed rollout. Your team works with our deployment lead throughout. We handle the infrastructure.'
  },
  {
    q: 'Is Fortify AI HIPAA compliant?',
    a: 'Fortify AI deployments are built for HIPAA, GDPR, SOC, and CCPA compliance. Deployments are configured to your regulatory environment and reviewed by your compliance team. Underwritten by Lloyd’s of London cybersecurity insurance policy.'
  },
  {
    q: 'What geographies does i-NETT cover?',
    a: 'i-NETT is headquartered in Southern California with primary client community across San Diego, Orange County, Los Angeles, and Ventura counties. Through the Technology Assurance Group network, we extend service into 148 cities across the United States and Canada.'
  },
  {
    q: 'How quickly can we get started?',
    a: 'The first step is a 30 minute consultation. From signed engagement, most firms see their first production AI workflow live within four to six weeks. Pilot length scales with the number of workflows in scope.'
  }
];

// Person schema for the four leaders. Rendered as a supplemental JSON-LD
// block alongside the BaseLayout schema graph.
const leadersSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#dale-stein`,
      name: 'Dale Stein',
      jobTitle: 'CEO & Partner',
      image: `${SITE.url}/assets/brand/dale-stein-headshot.jpg`,
      worksFor: { '@id': `${SITE.url}/#organization` },
      sameAs: ['https://www.linkedin.com/in/steindale/'],
      knowsAbout: ['Managed services', 'Telecommunications', 'Mid-market technology leadership'],
    },
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#nick-dreyfus`,
      name: 'Nick Dreyfus',
      jobTitle: 'Vice President of Business Development',
      image: `${SITE.url}/assets/brand/nick-headshot.jpg`,
      worksFor: { '@id': `${SITE.url}/#organization` },
      sameAs: [
        'https://www.linkedin.com/in/nicholas-dreyfus/',
        SITE.podcastUrl,
        'https://www.tiktok.com/@nick.dreyfus.inett',
        'https://www.instagram.com/nick.dreyfus.inett/',
      ],
      knowsAbout: ['Managed AI', 'Cybersecurity', 'HIPAA compliance', 'Mid-market IT strategy'],
      award: 'East County Chamber of Commerce Ambassador of the Year 2025',
    },
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#john-lehmkuhl`,
      name: 'John Lehmkuhl',
      jobTitle: 'Vice President of Operations',
      worksFor: { '@id': `${SITE.url}/#organization` },
      sameAs: ['https://www.linkedin.com/in/john-lehmkuhl/'],
      knowsAbout: ['Microsoft Azure', 'Amazon Web Services', 'Network security', 'IT operations'],
    },
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#oscar-salazar`,
      name: 'Oscar Salazar',
      jobTitle: 'Telecom Services Manager',
      worksFor: { '@id': `${SITE.url}/#organization` },
      sameAs: ['https://www.linkedin.com/in/oscar-salazar-94488311/'],
      knowsAbout: ['Converged communications', 'Telecommunications engineering', 'Project deployment'],
    },
  ],
};
---
<BaseLayout
  title="Fortify AI by i-NETT : Managed AI for mid-market firms"
  description="Managed AI for 30 to 150 employee firms in healthcare, legal, financial services, and professional services. Built for HIPAA, GDPR, SOC, and CCPA. Underwritten by Lloyd’s of London cybersecurity insurance policy. Serving Southern California, the United States, and Canada."
  faqs={faqs}
  service={{
    name: 'Fortify AI Managed AI Deployment',
    description: 'Managed AI deployment for mid-market firms in regulated industries. Configured for HIPAA, GDPR, SOC, and CCPA compliance.',
  }}
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__grid"></div>
      <div class="hero__orb hero__orb--a"></div>
      <div class="hero__orb hero__orb--b"></div>
    </div>
    <div class="container hero__inner">
      <div class="hero__copy reveal">
        <a href="/insurance-policy" class="pill pill-accent hero__pill hero__pill--link">
          <span class="hero__pulse" aria-hidden="true"></span>
          Underwritten by Lloyd&rsquo;s of London cybersecurity insurance policy
          <span class="hero__pill-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <h1 id="hero-heading" class="hero__title">
          Managed AI, <span class="hero__title-accent">built for the firms</span> regulators trust.
        </h1>
        <p class="hero__tagline">
          <span class="hero__tagline-word">Make</span>
          <span class="hero__tagline-word">every</span>
          <span class="hero__tagline-word">employee</span>
          <span class="hero__tagline-word">an</span>
          <span class="hero__tagline-word">AI</span>
          <span class="hero__tagline-word">expert.</span>
          <span class="hero__tagline-word hero__tagline-word--accent">Securely.</span>
        </p>
        <p class="hero__lead">
          Fortify AI deploys secure, compliance-ready AI infrastructure into healthcare,
          legal, financial services, and professional services firms across Southern California,
          the United States, and Canada. We operate it. You see results.
        </p>
        <div class="hero__ctas">
          <a href="/resources#scan" class="btn btn-accent btn-lg">
            Take the AI Readiness Scan
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={SITE.bookingUrl} class="btn btn-outline on-dark btn-lg" target="_blank" rel="noopener">
            Book a 30 minute consultation
          </a>
        </div>
        <ul class="hero__trust">
          <li>HIPAA, GDPR, SOC, CCPA ready</li>
          <li>Customer data isolated to your tenant</li>
          <li>148 service cities across US and Canada</li>
        </ul>
        <div class="hero__offers" aria-label="Free resources">
          <a class="hero__offer" href="/ai-usage-policy">
            <span class="hero__offer-tag">Free template</span>
            <span class="hero__offer-title">An AI usage policy your team can deploy today.</span>
          </a>
          <a class="hero__offer" href="/master-prompt">
            <span class="hero__offer-tag">Free, with a 30 minute call</span>
            <span class="hero__offer-title">Get a custom AI master prompt for your business.</span>
          </a>
        </div>
      </div>

      <aside class="hero__panel" aria-label="Fortify AI brand mark">
        <div class="hero-logo" data-hero-logo>
          <div class="hero-logo__halo" aria-hidden="true"></div>
          <div class="hero-logo__scan" aria-hidden="true"></div>
          <img
            src="/assets/brand/fortify-ai-logo.png"
            alt="Fortify AI by i-NETT"
            class="hero-logo__img"
            width="640"
            height="640"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </div>
      </aside>
    </div>
  </section>

  <!-- LOGO ROW / SOCIAL PROOF -->
  <section class="proof-bar">
    <div class="container">
      <p class="proof-bar__title reveal reveal-fade">Trusted by mid-market firms across the regulated industries</p>
      <div class="proof-bar__items">
        <div class="proof-pill reveal reveal-up reveal-delay-1">
          <img src="/assets/brand/hipaa-compliant.png" alt="HIPAA Compliant badge" width="36" height="36" loading="lazy" />
          <span>HIPAA Compliant</span>
        </div>
        <div class="proof-pill reveal reveal-up reveal-delay-2">
          <img src="/assets/brand/iso-27001.png" alt="ISO 27001 badge" width="36" height="36" loading="lazy" />
          <span>ISO 27001 aligned</span>
        </div>
        <a href="/insurance-policy" class="proof-pill proof-pill--text proof-pill--link reveal reveal-up reveal-delay-3">
          <span class="proof-pill__lead">Lloyd&rsquo;s of London</span>
          <span>Cybersecurity insurance policy</span>
        </a>
        <div class="proof-pill proof-pill--text reveal reveal-up reveal-delay-4">
          <span class="proof-pill__lead">TAG Network</span>
          <span>Member, <span data-countup="148" data-countup-suffix=" service cities, US &amp; Canada" class="countup">148 service cities, US &amp; Canada</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- WATCH FORTIFY AI IN ACTION (scripted demo) -->
  <DemoStream />

  <!-- WHAT WE DO -->
  <section class="section" id="what-we-do" aria-labelledby="what-we-do-heading">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">What we do</span>
        <h2 id="what-we-do-heading">Three things, done at the standard your industry actually requires.</h2>
        <p class="lead">
          Fortify AI is not an AI strategy deck. It is the infrastructure, the deployment, and
          the operating team that ships AI into your firm in weeks, not quarters.
        </p>
      </div>
      <div class="grid grid-3">
        <button type="button" class="card pillar-card reveal reveal-up reveal-delay-1" data-pillar-open="pillar-1" aria-haspopup="dialog">
          <span class="card-num">01</span>
          <h3>Compliance-first infrastructure</h3>
          <p>
            Each Fortify AI deployment is configured to your regulatory environment.
            Customer data is isolated to your dedicated tenant. We do not use customer
            data for model training or share it across clients.
          </p>
          <span class="pillar-card__more" aria-hidden="true">Read more <span class="pillar-card__arrow">&rarr;</span></span>
        </button>
        <button type="button" class="card pillar-card reveal reveal-up reveal-delay-2" data-pillar-open="pillar-2" aria-haspopup="dialog">
          <span class="card-num">02</span>
          <h3>Targeted, high-leverage workflows</h3>
          <p>
            We identify the two or three workflows where AI returns the most value to
            your firm in the first 90 days. Documentation, intake, summarization,
            knowledge retrieval, client communication. We ship those first.
          </p>
          <span class="pillar-card__more" aria-hidden="true">Read more <span class="pillar-card__arrow">&rarr;</span></span>
        </button>
        <button type="button" class="card pillar-card reveal reveal-up reveal-delay-3" data-pillar-open="pillar-3" aria-haspopup="dialog">
          <span class="card-num">03</span>
          <h3>Managed operations</h3>
          <p>
            i-NETT operates the deployment. Monitoring, updates, model evaluation,
            policy enforcement, and quarterly compliance review are included. Your
            team uses the system. We run it.
          </p>
          <span class="pillar-card__more" aria-hidden="true">Read more <span class="pillar-card__arrow">&rarr;</span></span>
        </button>
      </div>
    </div>

    <!-- Pillar detail modals -->
    <div class="pillar-modal" data-pillar-modal="pillar-1" hidden role="dialog" aria-modal="true" aria-labelledby="pillar-1-title">
      <div class="pillar-modal__backdrop" data-pillar-close></div>
      <div class="pillar-modal__panel" role="document">
        <header class="pillar-modal__head">
          <span class="card-num">01</span>
          <button class="pillar-modal__close" type="button" data-pillar-close aria-label="Close detail">
            <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" aria-hidden="true">
              <path d="M6 6 L18 18 M18 6 L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </header>
        <div class="pillar-modal__body">
          <div class="pillar-modal__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="56" height="56" focusable="false">
              <path d="M32 6 L52 14 V30 C52 44 32 58 32 58 C32 58 12 44 12 30 V14 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
              <path d="M22 32 L28 38 L42 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h2 id="pillar-1-title">Compliance-first infrastructure</h2>
          <p>
            Every Fortify AI deployment starts with your regulatory environment, not
            ours. We configure infrastructure to meet the specific compliance posture
            of your industry: HIPAA for healthcare, SOC 2 and GLBA for financial
            services, attorney-client privilege protections for legal firms, and
            CCPA, GDPR, and PIPEDA for cross-border operations.
          </p>
          <p>
            Customer data is isolated to your dedicated tenant. We do not use your
            data for model training. We do not share data across clients. Your
            compliance team reviews our deployment posture before go-live, with
            documentation maintained for regulator audits.
          </p>
          <h3 class="pillar-modal__outcomes-head">Business outcomes</h3>
          <ul class="pillar-modal__outcomes">
            <li>Compliance review completed before deployment, not after an incident</li>
            <li>Audit-ready documentation maintained continuously</li>
            <li>Dedicated tenant architecture, no shared training data</li>
            <li>Configured to your regulatory environment, not a generic compliance baseline</li>
          </ul>
          <div class="pillar-modal__cta">
            <a href={SITE.bookingUrl} class="btn btn-accent btn-lg" target="_blank" rel="noopener">
              Book a 30 minute consultation
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="pillar-modal" data-pillar-modal="pillar-2" hidden role="dialog" aria-modal="true" aria-labelledby="pillar-2-title">
      <div class="pillar-modal__backdrop" data-pillar-close></div>
      <div class="pillar-modal__panel" role="document">
        <header class="pillar-modal__head">
          <span class="card-num">02</span>
          <button class="pillar-modal__close" type="button" data-pillar-close aria-label="Close detail">
            <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" aria-hidden="true">
              <path d="M6 6 L18 18 M18 6 L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </header>
        <div class="pillar-modal__body">
          <div class="pillar-modal__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="56" height="56" focusable="false">
              <circle cx="32" cy="32" r="22" fill="none" stroke="currentColor" stroke-width="2.5"/>
              <path d="M32 16 V32 L42 38" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="32" cy="32" r="3" fill="currentColor"/>
            </svg>
          </div>
          <h2 id="pillar-2-title">Targeted, high-leverage workflows</h2>
          <p>
            AI deployment fails when firms try to implement everything at once. We
            identify the two or three workflows where AI returns the most value to
            your firm in the first 90 days: documentation, intake, summarization,
            knowledge retrieval, client communication.
          </p>
          <p>
            We ship those workflows first, measure the outcomes, then expand based on
            what is actually working. No multi-year roadmap. No platform play. Just
            measurable wins in the first quarter, with the next quarter informed by
            what we learned in this one.
          </p>
          <h3 class="pillar-modal__outcomes-head">Business outcomes</h3>
          <ul class="pillar-modal__outcomes">
            <li>First production workflow live in under 30 days</li>
            <li>Two to three high-value workflows operational within 90 days</li>
            <li>Measurable hours saved per employee, documented per workflow</li>
            <li>Expansion roadmap driven by measured outcomes, not promised features</li>
          </ul>
          <div class="pillar-modal__cta">
            <a href={SITE.bookingUrl} class="btn btn-accent btn-lg" target="_blank" rel="noopener">
              Book a 30 minute consultation
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="pillar-modal" data-pillar-modal="pillar-3" hidden role="dialog" aria-modal="true" aria-labelledby="pillar-3-title">
      <div class="pillar-modal__backdrop" data-pillar-close></div>
      <div class="pillar-modal__panel" role="document">
        <header class="pillar-modal__head">
          <span class="card-num">03</span>
          <button class="pillar-modal__close" type="button" data-pillar-close aria-label="Close detail">
            <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" aria-hidden="true">
              <path d="M6 6 L18 18 M18 6 L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </header>
        <div class="pillar-modal__body">
          <div class="pillar-modal__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="56" height="56" focusable="false">
              <rect x="10" y="14" width="44" height="36" rx="4" fill="none" stroke="currentColor" stroke-width="2.5"/>
              <path d="M10 24 H54" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="17" cy="19" r="1.4" fill="currentColor"/>
              <circle cx="22" cy="19" r="1.4" fill="currentColor"/>
              <path d="M20 36 L28 44 L44 28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h2 id="pillar-3-title">Managed operations</h2>
          <p>
            We do not hand your team a platform and walk away. Our team operates the
            deployment: monitoring, model evaluation, prompt library maintenance,
            policy enforcement, version updates, and quarterly compliance review.
            Your team uses the system. We run it.
          </p>
          <p>
            This is the difference between buying AI software and buying AI
            operations. The former leaves you responsible for an entire new
            technology stack. The latter lets your team focus on the work that
            drives the business.
          </p>
          <h3 class="pillar-modal__outcomes-head">Business outcomes</h3>
          <ul class="pillar-modal__outcomes">
            <li>24/7 monitoring and incident response</li>
            <li>Quarterly compliance review included</li>
            <li>Model and prompt library updates handled by our team</li>
            <li>Your team uses the system, we operate the infrastructure</li>
          </ul>
          <div class="pillar-modal__cta">
            <a href={SITE.bookingUrl} class="btn btn-accent btn-lg" target="_blank" rel="noopener">
              Book a 30 minute consultation
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THREE THINGS YOU CANNOT BUY ANYWHERE ELSE -->
  {/*
    Specific efficacy figures pending HermanScience source documentation
    and John Lehmkuhl review. Until then, copy uses directional language
    only ("dramatically reduces", "measurably improves", "significantly
    reduces"). Do not insert percentages here without sourced backing.
  */}
  <section class="section section-three" id="three-things" aria-labelledby="three-things-heading">
    <div class="container">
      <div class="section-intro reveal reveal-up">
        <span class="eyebrow">Three things you cannot buy anywhere else</span>
        <h2 id="three-things-heading">What separates Fortify AI from every other AI platform on the market.</h2>
      </div>
      <div class="three-grid">
        <article class="three-card reveal reveal-up reveal-delay-1">
          <div class="three-card__icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="28" height="28" focusable="false">
              <path d="M16 3 L26 7 V15 C26 22 16 28 16 28 C16 28 6 22 6 15 V7 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="M11 16 L14 19 L21 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>Completely secure AI</h3>
          <p>
            No other LLM platform offers this isolation posture. Your data stays in
            your tenant, with no shared training, no cross-client exposure, and
            architecture configured to your regulatory environment.
          </p>
        </article>

        <article class="three-card three-card--featured reveal reveal-up reveal-delay-2">
          <div class="three-card__icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="28" height="28" focusable="false">
              <circle cx="16" cy="16" r="11" fill="none" stroke="currentColor" stroke-width="2"/>
              <path d="M16 9 V16 L21 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <circle cx="16" cy="16" r="2" fill="currentColor"/>
            </svg>
          </div>
          <h3>Automations built for your team</h3>
          <p>
            Not self-serve tooling. Done-for-you operations that map to how your team
            actually works, deployed and maintained by people who understand your
            business.
          </p>
        </article>

        <article class="three-card reveal reveal-up reveal-delay-3">
          <div class="three-card__icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="28" height="28" focusable="false">
              <circle cx="16" cy="11" r="5" fill="none" stroke="currentColor" stroke-width="2"/>
              <path d="M7 27 C7 22 11 19 16 19 C21 19 25 22 25 27" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M22 8 L24 6 L27 6 L27 9 L25 11" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>A full-time prompt coach</h3>
          <p>
            Behavioral science guidance built into every interaction. Dramatically
            reduces bad answers and hallucinations. Gives employees back hours every
            week. Powered by HermanScience behavioral science methodology.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section section-dark" id="why-us" aria-labelledby="why-us-heading">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">Why Fortify AI</span>
        <h2 id="why-us-heading">Three things consumer AI cannot give you.</h2>
      </div>
      <div class="grid grid-3">
        <div class="card card-dark reveal reveal-up reveal-delay-1">
          <h3>An underwritten security posture</h3>
          <p>
            Fortify AI deployments are operated inside an environment underwritten by
            Lloyd&rsquo;s of London cybersecurity insurance policy. That is not marketing
            language. It is a financial backstop.
          </p>
        </div>
        <div class="card card-dark reveal reveal-up reveal-delay-2">
          <h3>A regulatory blueprint, not a checkbox</h3>
          <p>
            HIPAA, GDPR, SOC, and CCPA are designed into deployment from day one,
            then reviewed by your compliance team. You get a configuration you can
            defend, not a vendor questionnaire you have to chase.
          </p>
        </div>
        <div class="card card-dark reveal reveal-up reveal-delay-3">
          <h3>A managed services team behind the model</h3>
          <p>
            AI without operations is a liability. We bring 20 plus years of managed
            services discipline into every Fortify AI rollout, including 24/7 monitoring
            through the Technology Assurance Group network.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section how-section" id="how-it-works" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-intro reveal">
        <span class="eyebrow">How it works</span>
        <h2 id="how-heading">From first conversation to live deployment in four to six weeks.</h2>
      </div>
      <ol class="how-steps">
        <li class="how-step reveal">
          <span class="how-step__num">1</span>
          <div>
            <h3>30 minute consultation</h3>
            <p>
              We scope your environment, your compliance footprint, and the two or
              three highest-leverage AI deployments for your firm.
            </p>
          </div>
        </li>
        <li class="how-step reveal">
          <span class="how-step__num">2</span>
          <div>
            <h3>Readiness assessment</h3>
            <p>
              We map your data sources, your existing systems, and the regulatory
              constraints that will shape the configuration. You receive a written
              readiness scan.
            </p>
          </div>
        </li>
        <li class="how-step reveal">
          <span class="how-step__num">3</span>
          <div>
