  <script>
    // Pause the hero gradient mesh once the hero scrolls out of view.
    // Saves frames on long pages and respects user attention.
    const hero = document.querySelector<HTMLElement>('.hero');
    if (hero && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            hero.classList.toggle('is-paused', !entry.isIntersecting);
          });
        },
        { threshold: 0 }
      );
      io.observe(hero);
    }

    // Pillar detail modals. Open on card click, close on backdrop / X / Esc,
    // trap focus inside the panel, restore focus to the opener on close.
    const pillarOpeners = document.querySelectorAll<HTMLElement>('[data-pillar-open]');
    const pillarModals = document.querySelectorAll<HTMLElement>('[data-pillar-modal]');
    let pillarLastFocus: HTMLElement | null = null;

    const openPillar = (id: string, opener: HTMLElement) => {
      const modal = document.querySelector<HTMLElement>(`[data-pillar-modal="${id}"]`);
      if (!modal) return;
      pillarLastFocus = opener;
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      const closeBtn = modal.querySelector<HTMLElement>('.pillar-modal__close');
      closeBtn?.focus();
    };

    const closePillar = (modal: HTMLElement) => {
      modal.hidden = true;
      // Only restore scroll if no other modal is open.
      const anyOpen = Array.from(pillarModals).some((m) => !m.hidden);
      if (!anyOpen) document.documentElement.style.overflow = '';
      pillarLastFocus?.focus();
    };

    pillarOpeners.forEach((opener) => {
      opener.addEventListener('click', () => {
        const id = opener.getAttribute('data-pillar-open');
        if (id) openPillar(id, opener);
      });
    });

    pillarModals.forEach((modal) => {
      modal.querySelectorAll<HTMLElement>('[data-pillar-close]').forEach((c) =>
        c.addEventListener('click', () => closePillar(modal))
      );
      modal.addEventListener('keydown', (e) => {
        if (modal.hidden) return;
        const ke = e as KeyboardEvent;
        if (ke.key === 'Tab') {
          const focusables = modal.querySelectorAll<HTMLElement>(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          );
          if (!focusables.length) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (ke.shiftKey && document.activeElement === first) {
            e.preventDefault(); last.focus();
          } else if (!ke.shiftKey && document.activeElement === last) {
            e.preventDefault(); first.focus();
          }
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      pillarModals.forEach((m) => { if (!m.hidden) closePillar(m); });
    });
  </script>

