---
// Standalone, print-first report page. Renders the Fortify AI Readiness Report
// from data passed in the URL hash (#r=<encoded>) — no server round-trip, no
// site chrome. Falls back to a sample when no data is present.
import { reportCss } from '@lib/report';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Fortify AI Readiness &amp; Risk Report</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
  <style>
    body { margin: 0; font-family: 'IBM Plex Sans', system-ui, sans-serif; color: #0C1622; }
    .fa-bar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 18px; background: rgba(7,10,16,0.92); backdrop-filter: blur(6px); color: #cdd7e0; font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.12em; }
    .fa-bar b { color: #7FD4F2; }
    .fa-print { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.1em; color: #071523; background: #7FD4F2; border: none; padding: 8px 16px; cursor: pointer; }
    .fa-print:hover { background: #a6e4fb; }
    .fa-missing { color: #cdd7e0; max-width: 520px; margin: 12vh auto; text-align: center; font-family: 'IBM Plex Sans', sans-serif; line-height: 1.6; }
  </style>
  <style set:html={reportCss()}></style>
</head>
<body class="fa-desk">
  <div class="fa-bar fa-no-print">
    <span><b>FORTIFY AI</b> · YOUR READINESS &amp; RISK REPORT</span>
    <button class="fa-print" onclick="window.print()">SAVE AS PDF ↓</button>
  </div>
  <div class="fa-report" id="report"></div>

  <script>
    import { decodeReport, sampleReport } from '@lib/report';
    import { renderReport } from '@lib/reportClient';
    const host = document.getElementById('report');
    const raw = location.hash.replace(/^#r?=?/, '');
    let data = raw ? decodeReport(decodeURIComponent(raw)) : null;
    if (!data) data = sampleReport();
    if (data && host) {
      host.innerHTML = renderReport(data, { glow: true });
      document.title = 'Fortify AI Report — ' + (data.preparedFor?.company || 'Your Scan Results');
    } else if (host) {
      host.innerHTML = '<div class="fa-missing">This report link is missing or invalid. Please use the link from your scan email, or take the scan at <a href="/resources#scan" style="color:#7FD4F2">i-nett.ai/resources</a>.</div>';
    }
  </script>
</body>
</html>
