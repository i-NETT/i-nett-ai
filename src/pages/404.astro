---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE, NAV_PRIMARY } from '@lib/site';
---
<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found. Browse the main Fortify AI navigation or return to the homepage."
  noindex={true}
>
  <section class="error-section">
    <div class="container container-narrow error-inner">
      <p class="error-code">404</p>
      <h1>That page is not here.</h1>
      <p class="lead">
        The URL you visited does not exist on i-nett.ai. It may have been moved, or you may
        have followed an outdated link. The main destinations below cover most of what people
        come looking for.
      </p>

      <div class="error-ctas">
        <a href="/" class="btn btn-accent btn-lg">Return to the homepage</a>
        <a href={SITE.bookingUrl} class="btn btn-outline btn-lg" target="_blank" rel="noopener">
          Book a 30 minute consultation
        </a>
      </div>

      <div class="error-nav">
        <h2>Main pages</h2>
        <ul>
          {NAV_PRIMARY.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/contact">Contact</a></li>
          <li><a href="/coverage">Coverage</a></li>
          <li><a href="/resources">Resources</a></li>
          <li><a href="/podcast">Podcast</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-section {
    background: var(--color-ink-900);
    color: var(--color-text-on-dark);
    min-height: calc(100vh - var(--header-h));
    display: grid;
    place-items: center;
    padding: var(--space-9) 0;
  }
  .error-inner { text-align: center; }
  .error-code {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-glow);
    margin-bottom: var(--space-4);
    font-weight: 600;
  }
  .error-section h1 {
    color: #fff;
    font-size: var(--fs-4xl);
    margin-bottom: var(--space-5);
  }
  .error-section .lead {
    color: var(--color-text-on-dark-soft);
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-6);
  }
  .error-ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    justify-content: center;
    align-items: stretch;
    margin-bottom: var(--space-9);
  }
  @media (min-width: 640px) {
    .error-ctas { flex-direction: row; align-items: center; }
  }
  .error-nav {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: var(--space-7);
  }
  .error-nav h2 {
    color: #fff;
    font-size: var(--fs-md);
    margin-bottom: var(--space-4);
  }
  .error-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }
  .error-nav a {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-pill);
    color: var(--color-text-on-dark);
    font-size: var(--fs-sm);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .error-nav a:hover {
    background: rgba(0,180,255,0.16);
    border-color: var(--color-accent-500);
    color: #fff;
  }
</style>
