---
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@lib/site';
import { getEpisodes } from '@lib/podcast';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Podcast', url: '/podcast' },
];

const APPLE_SHOW_ID = '1764658911';
const appleEmbedSrc = `https://embed.podcasts.apple.com/us/podcast/the-digital-dilemma/id${APPLE_SHOW_ID}`;

const episodes = await getEpisodes();
const featuredEpisodes = episodes.slice(0, 5);
---
<PageLayout
  title="The Digital Dilemma Podcast, hosted by Nick Dreyfus"
  description="The Digital Dilemma is a podcast hosted by Nick Dreyfus, VP of Business Development at i-NETT. Conversations with founders, technologists, and CEOs on AI, cybersecurity, compliance, and the operational realities of running a modern mid-market business. Listen on Apple Podcasts, browse recent episodes, and subscribe."
  eyebrow="The Digital Dilemma"
  pageHeading="A podcast for the mid-market CEO making technology decisions in real time."
  pageLead="Hosted by Nick Dreyfus, VP of Business Development at i-NETT. Conversations on AI, cybersecurity, compliance, and the operational realities of running a modern business. Listen below or subscribe on Apple Podcasts."
  breadcrumbs={breadcrumbs}
  podcast={true}
  hideFinalCta={true}
>
  <!-- APPLE PODCASTS SHOW EMBED -->
  <section class="section" aria-labelledby="listen-heading">
    <div class="container container-narrow">
      <span class="eyebrow reveal reveal-fade">Listen and subscribe</span>
      <h2 id="listen-heading" class="reveal reveal-up">Recent episodes, straight from Apple Podcasts.</h2>
      <p class="lead reveal reveal-up reveal-delay-1">
        Hit play below to browse the latest episodes. Open in Apple Podcasts to
        subscribe so new episodes arrive automatically.
      </p>

      <div class="apple-embed reveal reveal-up reveal-delay-2">
        <iframe
          title="The Digital Dilemma on Apple Podcasts"
          src={appleEmbedSrc}
          height="450"
          loading="lazy"
          allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
          sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER CALLOUT -->
  <section class="section section-soft" aria-labelledby="newsletter-heading">
    <div class="container container-narrow">
      <div class="newsletter-callout reveal reveal-up">
        <span class="eyebrow">From the newsletter</span>
        <h2 id="newsletter-heading">The Digital Dilemma newsletter, on the blog.</h2>
        <p class="lead">
          Read the latest editorial drop from The Digital Dilemma newsletter,
          cross-posted to the i-NETT blog.
        </p>
        <a href="/blog/navigating-ai-tools-risks-and-solutions-for-leaders" class="btn btn-accent">
          Read: Navigating AI, Tools, Risks, and Solutions for Leaders
        </a>
      </div>
    </div>
  </section>

  <!-- FEATURED LONG-FORM EPISODES -->
  <section class="section" aria-labelledby="featured-heading">
    <div class="container">
      <div class="featured-head reveal reveal-fade">
        <span class="eyebrow">Featured episodes</span>
        <h2 id="featured-heading">Five recent conversations worth your commute.</h2>
        <p class="lead">
          The most recent episodes from The Digital Dilemma. Tap any episode for show
          notes, the audio player, and the YouTube video when available.
        </p>
      </div>

      <ol class="ep-list">
        {featuredEpisodes.map((ep, i) => (
          <li class:list={['ep-card', 'reveal', 'reveal-up', `reveal-delay-${(i % 6) + 1}`]}>
            <div class="ep-card__meta">
              <span class="ep-card__num">{ep.code ?? `EP ${i + 1}`}</span>
              <h3 class="ep-card__title">
                <a href={`/podcast/${ep.slug}`}>{ep.title}</a>
              </h3>
              <p class="ep-card__date">{ep.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
              <div class="ep-card__ctas">
                <a href={`/podcast/${ep.slug}`} class="btn btn-primary">
                  Open episode
                </a>
                {ep.youtubeId && (
                  <a href={`https://www.youtube.com/watch?v=${ep.youtubeId}`} class="btn btn-outline" target="_blank" rel="noopener">
                    Watch on YouTube
                  </a>
                )}
              </div>
            </div>
            <div class="ep-card__art" aria-hidden="true">
              {ep.image ? (
                <img src={ep.image} alt="" loading="lazy" />
              ) : (
                <span class="ep-card__art-num">{ep.code ?? `EP ${i + 1}`}</span>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ALL EPISODES (full crawlable list) -->
  <section class="section section-soft" aria-labelledby="all-eps-heading">
    <div class="container">
      <div class="all-eps-head reveal reveal-fade">
        <span class="eyebrow">All episodes</span>
        <h2 id="all-eps-heading">Every episode of The Digital Dilemma.</h2>
        <p class="lead">
          Browse the full archive. Each episode has its own page with show notes,
          the audio player, and the YouTube video when available.
        </p>
      </div>
      <ul class="all-eps-list" role="list">
        {episodes.map((ep) => (
          <li class="all-eps-item">
            <a class="all-eps-link" href={`/podcast/${ep.slug}`}>
              <span class="all-eps-code">{ep.code ?? '—'}</span>
              <span class="all-eps-title">{ep.title}</span>
              <span class="all-eps-date">{ep.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- WHAT TO EXPECT -->
  <section class="section section-soft" aria-labelledby="expect-heading">
    <div class="container container-narrow">
      <span class="eyebrow reveal reveal-fade">What to expect</span>
      <h2 id="expect-heading" class="reveal reveal-up">Conversations our buyer is already having.</h2>
      <ul class="topic-list">
        <li class="reveal reveal-up reveal-delay-1"><strong>How AI changes the operating model</strong> of a mid-market practice, firm, or business.</li>
        <li class="reveal reveal-up reveal-delay-2"><strong>Compliance and AI:</strong> HIPAA, GDPR, SOC, CCPA, and what defensible deployment actually looks like.</li>
        <li class="reveal reveal-up reveal-delay-3"><strong>Cybersecurity for mid-market firms:</strong> posture, insurance, incident readiness.</li>
        <li class="reveal reveal-up reveal-delay-4"><strong>Operating discipline:</strong> how high-performing firms run technology decisions.</li>
        <li class="reveal reveal-up reveal-delay-5"><strong>Founder conversations:</strong> candid interviews with operators and technologists.</li>
      </ul>
    </div>
  </section>

  <!-- STANDARD PODCAST CTA TRIO -->
  <section class="section section-dark" aria-labelledby="trio-heading">
    <div class="container container-narrow">
      <div class="trio-head reveal reveal-fade">
        <span class="eyebrow">Next step</span>
        <h2 id="trio-heading">Pick your channel.</h2>
        <p class="lead">
          Three doors. Book a consultation, visit the parent organization, or subscribe
          to the podcast. They all lead to the same conversation.
        </p>
      </div>
      <div class="trio">
        <a href={SITE.bookingUrl} class="trio-card reveal reveal-up reveal-delay-1" target="_blank" rel="noopener">
          <span class="trio-card__label">Book a consultation</span>
          <span class="trio-card__line">30 minute Fortify AI consultation via HubSpot.</span>
          <span class="trio-card__url">meetings-na2.hubspot.com</span>
          <span class="trio-card__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href={SITE.parentUrl} class="trio-card reveal reveal-up reveal-delay-2" target="_blank" rel="noopener">
          <span class="trio-card__label">Visit i-NETT</span>
          <span class="trio-card__line">Parent organization: managed IT, cybersecurity, managed AI.</span>
          <span class="trio-card__url">i-nett.com</span>
          <span class="trio-card__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href={SITE.podcastUrl} class="trio-card reveal reveal-up reveal-delay-3" target="_blank" rel="noopener">
          <span class="trio-card__label">Subscribe on Apple</span>
          <span class="trio-card__line">The Digital Dilemma, new episodes automatically.</span>
          <span class="trio-card__url">podcasts.apple.com</span>
          <span class="trio-card__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Apple embed */
  .apple-embed {
    margin-top: var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    box-shadow: 0 20px 40px rgba(10, 37, 64, 0.08);
  }
  .apple-embed iframe {
    width: 100%;
    border: 0;
    display: block;
  }

  /* Shorts row */
  .shorts-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-7);
  }
  .shorts-head h2 { margin-top: var(--space-2); }
  .shorts-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .shorts-row { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 960px) {
    .shorts-row { grid-template-columns: repeat(6, 1fr); }
  }
  .short-card {
    display: block;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    transition: transform 240ms var(--ease-out), border-color 240ms var(--ease-out), box-shadow 240ms var(--ease-out);
  }
  .short-card:hover {
    transform: translateY(-3px) scale(var(--hover-scale-card));
    z-index: 3;
    border-color: var(--color-accent-500);
    box-shadow: 0 14px 28px rgba(10, 37, 64, 0.08);
    color: var(--color-text);
  }
  .short-card__thumb {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: grid;
    place-items: center;
    margin-bottom: var(--space-2);
  }
  .short-card--from-cyan .short-card__thumb {
    background: linear-gradient(160deg, #00B4FF 0%, #11355C 100%);
  }
  .short-card--from-blue .short-card__thumb {
    background: linear-gradient(160deg, #11355C 0%, #050B14 100%);
  }
  .short-card--from-deep .short-card__thumb {
    background: linear-gradient(160deg, #050B14 0%, #00B4FF 130%);
  }
  .short-card__play {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    display: inline-grid;
    place-items: center;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 240ms var(--ease-out), background 240ms var(--ease-out);
  }
  .short-card:hover .short-card__play {
    transform: scale(1.1);
    background: rgba(255, 255, 255, 0.3);
  }
  .short-card__label {
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--color-ink-800);
    margin: 0;
  }
  .short-card__note {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }

  /* Featured episodes */
  .featured-head {
    margin-bottom: var(--space-7);
    max-width: 64ch;
  }
  .featured-head h2 { margin-top: var(--space-2); }
  .featured-head .lead { margin-top: var(--space-3); }
  .ep-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }
  .ep-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: transform 320ms var(--ease-out), border-color 320ms var(--ease-out), box-shadow 320ms var(--ease-out);
  }
  @media (min-width: 720px) {
    .ep-card { grid-template-columns: 1fr 160px; align-items: center; }
  }
  .ep-card:hover {
    transform: translateY(-2px) scale(var(--hover-scale-card));
    z-index: 3;
    border-color: var(--color-accent-500);
    box-shadow: 0 18px 36px rgba(10, 37, 64, 0.08);
  }
  .ep-card__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-accent-500);
    letter-spacing: 0.12em;
    font-weight: 600;
  }
  .ep-card__title {
    font-size: var(--fs-lg);
    margin: var(--space-2) 0;
  }
  .ep-card__summary {
    color: var(--color-text-soft);
    margin-bottom: var(--space-4);
  }
  .ep-card__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  @media (min-width: 480px) {
    .ep-card__ctas { flex-direction: row; align-items: center; }
  }
  .ep-card__youtube-pending {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.5em 0.85em;
    background: var(--color-bg-soft);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
  }
  .ep-card__art {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-ink-900) 0%, var(--color-accent-500) 130%);
    display: grid;
    place-items: center;
    color: #fff;
  }
  .newsletter-callout {
    text-align: center;
    padding: var(--space-7) var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }
  .newsletter-callout h2 { margin: var(--space-3) 0 var(--space-4); }
  .newsletter-callout .lead { margin-bottom: var(--space-5); }
  .ep-card__date {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-3);
  }
  .ep-card__title a { color: inherit; text-decoration: none; }
  .ep-card__title a:hover { color: var(--color-accent-500); }
  .ep-card__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .all-eps-head { text-align: center; max-width: 760px; margin: 0 auto var(--space-7); }
  .all-eps-head h2 { margin-top: var(--space-2); }
  .all-eps-head .lead { margin-top: var(--space-3); }
  .all-eps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .all-eps-link {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-ink-800);
    transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .all-eps-link:hover { border-color: var(--color-accent-500); background: var(--color-bg-soft); }
  .all-eps-code {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-accent-500);
    font-weight: 700;
  }
  .all-eps-title { font-weight: 600; }
  .all-eps-date { color: var(--color-text-muted); font-size: var(--fs-xs); white-space: nowrap; }
  @media (max-width: 640px) {
    .all-eps-link { grid-template-columns: 60px 1fr; }
    .all-eps-date { grid-column: 2; font-size: var(--fs-xs); }
  }
  .ep-card__art-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    opacity: 0.85;
  }

  /* Topic list */
  .topic-list {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0;
    display: grid;
    gap: var(--space-3);
  }
  .topic-list li {
    padding: var(--space-4);
    background: var(--color-bg);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-accent-500);
  }

  /* Trio */
  .trio-head { text-align: center; margin-bottom: var(--space-7); }
  .trio-head h2 { color: #fff; margin-top: var(--space-2); }
  .trio-head .lead {
    color: var(--color-text-on-dark-soft);
    margin-left: auto;
    margin-right: auto;
    margin-top: var(--space-3);
  }
  .trio {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .trio { grid-template-columns: repeat(3, 1fr); }
  }
  .trio-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    color: var(--color-text-on-dark);
    transition: transform 240ms var(--ease-out), border-color 240ms var(--ease-out), background 240ms var(--ease-out);
  }
  .trio-card:hover {
    transform: translateY(-3px) scale(var(--hover-scale-card));
    z-index: 3;
    border-color: var(--color-accent-500);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-on-dark);
  }
  .trio-card__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-lg);
    color: #fff;
  }
  .trio-card__line {
    color: var(--color-text-on-dark-soft);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }
  .trio-card__url {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-glow);
    letter-spacing: 0.04em;
    margin-top: var(--space-3);
  }
  .trio-card__arrow {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    color: var(--color-glow);
    font-size: 1.25rem;
    transition: transform 240ms var(--ease-out);
  }
  .trio-card:hover .trio-card__arrow { transform: translateX(4px); }
</style>
