---
import PageLayout from '@layouts/PageLayout.astro';
import { getEpisodes, stripHtml } from '@lib/podcast';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
];

const episodes = await getEpisodes();
const articles = (await getCollection('blog')).filter((a) => !a.data.draft);

type FeedItem = {
  kind: 'episode' | 'article';
  title: string;
  description: string;
  href: string;
  date: Date;
  tag: string;
  image?: string;
};

const feed: FeedItem[] = [
  ...episodes.map((e) => ({
    kind: 'episode' as const,
    title: e.title,
    description: stripHtml(e.descriptionHtml).slice(0, 180),
    href: `/podcast/${e.slug}`,
    date: e.pubDate,
    tag: e.code ? `Podcast · ${e.code}` : 'Podcast',
    image: e.image,
  })),
  ...articles.map((a) => ({
    kind: 'article' as const,
    title: a.data.title,
    description: a.data.description,
    href: `/blog/${a.id}`,
    date: a.data.datePublished,
    tag: 'Article',
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<PageLayout
  title="Blog and Podcast | Fortify AI by i-NETT"
  description="Every episode of The Digital Dilemma plus written guidance on managed AI, compliance, and the operational realities of deploying AI inside mid-market firms."
  eyebrow="Insights"
  pageHeading="The Digital Dilemma, and what we are writing about."
  pageLead="Every podcast episode, plus articles on managed AI, compliance configuration, and the decisions that matter for mid-market leaders."
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
>
  <section class="section">
    <div class="container">
      <div class="feed-grid">
        {feed.map((it) => (
          <a class="feed-card" href={it.href}>
            {it.image && (
              <img class="feed-card__img" src={it.image} alt="" loading="lazy" width="320" height="320" />
            )}
            <div class="feed-card__body">
              <span class="feed-card__tag">{it.tag}</span>
              <h2 class="feed-card__title">{it.title}</h2>
              <p class="feed-card__desc">{it.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .feed-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .feed-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .feed-grid { grid-template-columns: 1fr 1fr 1fr; } }
  .feed-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .feed-card:hover { border-color: var(--color-accent-500); box-shadow: var(--shadow-md); transform: translateY(-2px) scale(var(--hover-scale-card)); z-index: 3; }
  .feed-card__img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; background: var(--color-bg-muted); }
  .feed-card__body { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); }
  .feed-card__tag {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-accent-500);
  }
  .feed-card__title { font-size: var(--fs-md); line-height: var(--lh-snug); }
  .feed-card__desc { color: var(--color-text-soft); font-size: var(--fs-sm); }
</style>
