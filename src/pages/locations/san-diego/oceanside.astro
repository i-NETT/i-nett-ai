---
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@lib/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url: '/coverage' },
  { name: 'San Diego', url: '/locations/san-diego' },
  { name: 'Oceanside', url: '/locations/san-diego/oceanside' },
];
---
<PageLayout
  title="Managed AI in Oceanside : Fortify AI by i-NETT"
  description="Fortify AI for Oceanside firms. Managed AI for healthcare, manufacturing, regional professional services, and military-adjacent businesses across Oceanside and North County. HIPAA, GDPR, SOC, CCPA ready."
  eyebrow="Oceanside, San Diego"
  pageHeading="Managed AI for Oceanside firms."
  pageLead="Oceanside&rsquo;s mid-market spans healthcare, manufacturing, regional professional services, and the businesses that serve the Camp Pendleton community. Fortify AI deploys compliance-ready AI for the operational realities of running a business in this corridor."
  breadcrumbs={breadcrumbs}
  localBusiness={{
    name: 'i-NETT (Oceanside)',
    url: `${SITE.url}/locations/san-diego/oceanside`,
    city: 'Oceanside',
    region: 'CA',
    lat: 33.1959,
    lng: -117.3795,
  }}
>
  <section class="section">
    <div class="container container-narrow">
      <span class="eyebrow">Built for Oceanside&rsquo;s buyer</span>
      <h2>Operational AI for healthcare, manufacturing, and regional services firms.</h2>
      <p class="lead">
        Oceanside&rsquo;s mid-market includes healthcare practices serving North County
        communities, manufacturing operations, regional professional services firms, and
        the businesses that support military and defense-adjacent operations. Each gets
        a Fortify AI deployment configured to their compliance footprint.
      </p>
      <ul class="check-list">
        <li>HIPAA configuration for healthcare practices</li>
        <li>Dedicated tenant, customer data isolated to your environment</li>
        <li>Configuration aligned to defense-adjacent compliance requirements where applicable</li>
        <li>Underwritten by Lloyd&rsquo;s of London cybersecurity insurance policy</li>
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .check-list { list-style: none; padding: 0; margin: var(--space-6) 0; display: grid; gap: var(--space-3); }
  .check-list li { padding-left: 2em; position: relative; }
  .check-list li::before {
    content: ''; position: absolute; left: 0; top: 0.4em;
    width: 18px; height: 18px;
    background: var(--color-accent-500);
    border-radius: 50%;
    box-shadow: inset 0 0 0 4px #fff, 0 0 0 2px var(--color-accent-500);
  }
</style>
