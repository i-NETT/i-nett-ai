---
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@lib/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url: '/coverage' },
  { name: 'Ventura', url: '/locations/ventura' },
];
---
<PageLayout
  title="AI Consulting and Managed AI in Ventura County : Fortify AI by i-NETT"
  description="Fortify AI for Ventura County businesses. Managed AI for mid-market firms in Oxnard, Thousand Oaks, Camarillo, Ventura, and Simi Valley. HIPAA, GDPR, SOC, CCPA ready."
  eyebrow="Ventura County"
  pageHeading="Managed AI for Ventura County firms."
  pageLead="Fortify AI deploys compliance-ready AI into mid-market businesses across Ventura County, including Oxnard, Thousand Oaks, Camarillo, Ventura, and Simi Valley. On-site engagement available throughout the readiness and pilot phases."
  breadcrumbs={breadcrumbs}
  localBusiness={{
    name: 'i-NETT (Ventura County)',
    url: `${SITE.url}/locations/ventura`,
    city: 'Ventura',
    region: 'CA',
    lat: 34.2746,
    lng: -119.2290,
  }}
>
  <section class="section">
    <div class="container container-narrow">
      <span class="eyebrow">What we deploy in Ventura County</span>
      <h2>Fortify AI for the firms that run this region.</h2>
      <p class="lead">
        Ventura County&rsquo;s mid-market firms span healthcare provider groups,
        agricultural operations, defense contractors, financial services, and
        professional services. Fortify AI deploys configured AI infrastructure that
        meets the compliance environment each of these industries operates inside.
      </p>
      <ul class="check-list">
        <li>HIPAA, GDPR, SOC, and CCPA configuration built into deployment</li>
        <li>Dedicated tenant, customer data isolated to your environment</li>
        <li>Discounted cyber insurance through our Lloyd&rsquo;s of London partnership</li>
        <li>On-site readiness and pilot sessions across Oxnard, Thousand Oaks, Camarillo, and surrounding cities</li>
      </ul>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <h2>Industries we serve in Ventura County</h2>
      <div class="grid grid-4">
        <a href="/industries/healthcare" class="card industry-card">
          <h3>Healthcare</h3>
          <p>HIPAA-aligned AI for practices and provider groups.</p>
          <span class="arrow">&rarr;</span>
        </a>
        <a href="/industries/legal" class="card industry-card">
          <h3>Legal</h3>
          <p>Privilege-aware AI for law firms.</p>
          <span class="arrow">&rarr;</span>
        </a>
        <a href="/industries/financial-services" class="card industry-card">
          <h3>Financial Services</h3>
          <p>Regulator-ready AI for advisors.</p>
          <span class="arrow">&rarr;</span>
        </a>
        <a href="/industries/professional-services" class="card industry-card">
          <h3>Professional Services</h3>
          <p>Confidentiality-first AI for consulting and accounting.</p>
          <span class="arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .industry-card { color: var(--color-text); position: relative; padding-bottom: var(--space-7); }
  .industry-card .arrow { position: absolute; bottom: var(--space-5); right: var(--space-5); color: var(--color-accent-500); }
  .check-list { list-style: none; padding: 0; margin: var(--space-6) 0; display: grid; gap: var(--space-3); }
  .check-list li { padding-left: 2em; position: relative; }
  .check-list li::before {
    content: ''; position: absolute; left: 0; top: 0.4em;
    width: 18px; height: 18px;
    background: var(--color-accent-500);
    border-radius: 50%;
    box-shadow: inset 0 0 0 4px #fff, 0 0 0 2px var(--color-accent-500);
  }
</style>
