---
import PageLayout from '@layouts/PageLayout.astro';
import AnswerBlock from '@components/AnswerBlock.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'AI Governance', url: '/ai-governance' },
];

const entries = (await getCollection('ai-governance')).sort(
  (a, b) => (b.data.datePublished?.valueOf() ?? 0) - (a.data.datePublished?.valueOf() ?? 0)
);

const faqs = [
  {
    q: 'What is AI governance?',
    a: 'AI governance is the set of policies, controls, and oversight practices that define how an organization adopts and uses artificial intelligence safely, covering acceptable use, approved tools, data protection, human review, and accountability.',
  },
  {
    q: 'Why does a mid-sized business need AI governance?',
    a: 'Employees at most companies already use AI tools, often without oversight. Governance gives them a clear, enforceable framework so the business gets AI productivity without exposing regulated or confidential data.',
  },
];
---
<PageLayout
  title="AI Governance for Organizations of Any Size | Fortify AI by i-NETT"
  description="Practical AI governance guidance for business leaders: usage policies, data-leak prevention, safe adoption in regulated industries, and Microsoft Copilot readiness."
  eyebrow="Authority hub"
  pageHeading="AI governance, written for the executives who have to answer for it."
  pageLead="Clear, quotable guidance on adopting AI without the risk. Policy templates, frameworks, and readiness checklists from the team behind Fortify AI."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  pageType="CollectionPage"
  speakable={['.answer-block__a']}
>
  <section class="section">
    <div class="container container-narrow">
      <AnswerBlock label="What this hub is">
        <p>
          The i-NETT AI Governance hub is a working library of practical guidance for
          business leaders adopting AI. Every guide opens with a direct, quotable
          answer, then a definitional block, then a deployable framework or checklist,
          followed by frequently asked questions. Use it to set policy, evaluate tools,
          and brief your board.
        </p>
      </AnswerBlock>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="gov-grid">
        {entries.map((e) => (
          <a class="gov-card" href={`/ai-governance/${e.id}`}>
            <h2>{e.data.title}</h2>
            <p>{e.data.description}</p>
            <span class="gov-card__cta">Read the guide</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .gov-grid { display: grid; gap: var(--space-5); grid-template-columns: 1fr; }
  @media (min-width: 720px) { .gov-grid { grid-template-columns: 1fr 1fr; } }
  .gov-card {
    display: block;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .gov-card:hover {
    border-color: var(--color-accent-500);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px) scale(var(--hover-scale-card));
    z-index: 3;
  }
  .gov-card h2 { font-size: var(--fs-lg); margin-bottom: var(--space-3); color: var(--color-ink-800); }
  .gov-card p { color: var(--color-text-soft); font-size: var(--fs-sm); margin-bottom: var(--space-4); }
  .gov-card__cta { color: var(--color-accent-500); font-weight: 600; font-size: var(--fs-sm); }
</style>
