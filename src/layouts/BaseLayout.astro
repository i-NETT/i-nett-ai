---
import '@/styles/global.css';
import SEO from '@components/SEO.astro';
import SchemaOrg from '@components/SchemaOrg.astro';
import Analytics from '@components/Analytics.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE } from '@lib/site';

interface BreadcrumbItem { name: string; url: string; }
interface FaqItem { q: string; a: string; }
interface LocalBusinessSpec {
  name: string; url: string; city: string; region?: string; lat?: number; lng?: number;
}
interface ServiceSpec { name: string; description: string; areaServed?: string[]; }

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  pageType?: 'WebPage' | 'WebApplication' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FaqItem[];
  localBusiness?: LocalBusinessSpec;
  service?: ServiceSpec;
  podcast?: boolean;
  person?: boolean;
  bodyClass?: string;
  speakable?: string[];
  article?: any;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  type = 'website',
  pageType = 'WebPage',
  breadcrumbs,
  faqs,
  localBusiness,
  service,
  podcast = false,
  person = false,
  bodyClass,
  speakable,
  article,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="shortcut icon" href="/favicon-32x32.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      onload="this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      type={type}
    />
    <SchemaOrg
      pageType={pageType}
      pageName={title}
      pageDescription={description}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
      localBusiness={localBusiness}
      service={service}
      podcast={podcast}
      person={person}
      speakable={speakable}
      article={article}
    />
    <Analytics />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll. Add hidden class then remove via IntersectionObserver.
      // Supports variants .reveal-up .reveal-fade .reveal-left .reveal-right .reveal-scale.
      // No-JS fallback: elements stay visible (default).
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reveals.length && 'IntersectionObserver' in window && !reduceMotion) {
        reveals.forEach((el) => el.classList.add('reveal--hidden'));
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.remove('reveal--hidden');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        reveals.forEach((el) => io.observe(el));
      }

      // Count-up animation for [data-countup] elements (final value attr).
      // Runs once when the element scrolls into view.
      const countups = document.querySelectorAll<HTMLElement>('[data-countup]');
      if (countups.length && 'IntersectionObserver' in window) {
        const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
        const cio = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const end = Number(el.getAttribute('data-countup') ?? '0');
            const prefix = el.getAttribute('data-countup-prefix') ?? '';
            const suffix = el.getAttribute('data-countup-suffix') ?? '';
            const dur = Number(el.getAttribute('data-countup-duration') ?? '1400');
            if (reduceMotion) { el.textContent = `${prefix}${fmt(end)}${suffix}`; cio.unobserve(el); return; }
            const start = performance.now();
            const tick = (now: number) => {
              const t = Math.min(1, (now - start) / dur);
              const eased = 1 - Math.pow(1 - t, 3);
              el.textContent = `${prefix}${fmt(end * eased)}${suffix}`;
              if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
            cio.unobserve(el);
          });
        }, { threshold: 0.4 });
        countups.forEach((el) => cio.observe(el));
      }

      // Button radial highlight follows the pointer (subtle hover sheen).
      document.addEventListener('pointermove', (e) => {
        const btn = (e.target as HTMLElement)?.closest('.btn') as HTMLElement | null;
        if (!btn) return;
        const r = btn.getBoundingClientRect();
        btn.style.setProperty('--mx', `${e.clientX - r.left}px`);
        btn.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    </script>
  </body>
</html>
